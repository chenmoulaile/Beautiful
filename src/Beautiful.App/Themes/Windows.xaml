<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Windows 11 原生语言（第四条主题线）：Win11 的任务栏/Dock 观感是
         ① 深色 Mica 底（不是 macOS 那种高透明亚克力，也不是鸿蒙的胶囊），
         ② 8px 圆角（Fluent 的默认控件圆角），
         ③ **没有悬停放大**（MaxScale=1，与 macOS 主题最大的差别），
         ④ 运行指示是"图标下方居中短横线"，不是 macOS 的圆点、也不是 GNOME 的左侧竖条，
         ⑤ 字体 Segoe UI Variable，强调色默认 #0078D4（开"壁纸取色"时同样会被覆盖）。
         这一套全部是参数与画刷，渲染器里没有 if (theme == windows)。
         注意：本主题的"美化"重心在原生任务栏那条线上（玻璃壳/歌词条），Dock 只是同一种语言的另一副面孔。 -->

    <SolidColorBrush x:Key="ThemeAccent" Color="#0078D4"/>
    <SolidColorBrush x:Key="ThemeDockBackground" Color="#F02B2B2B"/>
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ThemePanelBackground" Color="#1FFFFFFF"/>
    <!-- 本主题不画分隔符（Win11 任务栏没有"固定区 | 运行区"那道竖线），键留着让模板解析得到 -->
    <SolidColorBrush x:Key="ThemeDockSeparatorFill" Color="#33FFFFFF"/>
    <!-- 浮层主题 tint 覆盖层：与另两主题同一强度口径（声明色的 30% 叠加） -->
    <SolidColorBrush x:Key="ThemeBackdropTint" Color="#4D2B2B2B"/>
    <sys:String x:Key="ThemeIndicatorStyle">underline</sys:String>
    <FontFamily x:Key="ThemeFontFamily">Segoe UI Variable Display, Segoe UI Variable, Segoe UI</FontFamily>
    <CornerRadius x:Key="ThemePanelCornerRadius">8</CornerRadius>
    <sys:Double x:Key="ThemeIconSize">44</sys:Double>

    <!-- 本主题无底部圆点 -->
    <Style x:Key="ThemeIndicatorDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <!-- 本主题无左侧短条 -->
    <Style x:Key="ThemeIndicatorBar" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <!-- 实作（underline）：图标下方居中短横线，仅运行中的窗口条目显示 -->
    <Style x:Key="ThemeIndicatorUnderline" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Window">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
