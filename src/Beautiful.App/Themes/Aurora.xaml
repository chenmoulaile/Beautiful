<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Aurora（极光）主题 token：Aurora 骨架 + Adwaita Depth 层压卡语义 + Plasma Flow 胶囊指示。
         键面与 MacOS.xaml 完全同构（ThemeManager 按 /Themes/{Id}.xaml 自动加载，Mac*/Theme* 运行时键
         由 AuroraTokenDictionary.Apply 逐键写入——QuickLook/Finder/通知横幅等 Mac* 消费端不断键）。
         本文件的静态值只是**首帧兜底**：ApplyTheme 启动即按当前外观/强调色/字体重算覆写；
         发丝线四停与玻璃三停的静态值按 AuroraTokenDictionary 同公式复算（tools/_aurora-static-values.ps1）。
         字体：内嵌 Inter（OFL，Assets/Fonts/Inter/）→ 系统已装 Inter → Segoe UI Variable 回退；
         未带字体资产的 CI/公开仓库形态自动落到回退链，应用完整可用（与 D-FONT 验收边界同构）。
         ThemeIconClip 键由 ThemeManager 按需注入；本主题 IconCornerRadiusRatio=0 → 不注入 → 图标无 XAML 遮罩
         （形状由烘焙位图拥有，RoundedRectangle 0.2 + 柔影，与 macOS 同管道）。
         【悬浮】Dock 离边距离唯一生效源是用户设置 AppSettings.DockEdgeMargin（wp-detail r5 起默认 6，
         范围 0-24；老配置文件里已显式写入的值加载时原样保留），主题不写用户设置；
         Aurora 的悬浮观感由 26 圆角 + 行内呼吸（DockRowInsetDip 12）表达。 -->

    <SolidColorBrush x:Key="ThemeAccent" Color="#FF2FD4B4"/>
    <!-- Dock 面板玻璃底（上亮下沉三停，Aurora 公式首帧值：暗色 accent=签名青绿）。
         独立键而非复用 ThemeDockBackground：ThumbnailPreview.ReadColor 只认纯色 SolidColorBrush。
         运行时由 AuroraTokenDictionary 按亮暗/强调色/墙纸 tint 重算（亮模式玻璃更实是刻意的）。 -->
    <LinearGradientBrush x:Key="ThemeDockGlassBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D92F4A4E" Offset="0"/>
        <GradientStop Color="#C2203235" Offset="0.55"/>
        <GradientStop Color="#A6131D1F" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ThemePanelBackground" Color="#2BFFFFFF"/>
    <SolidColorBrush x:Key="ThemeDockSeparatorFill" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="ThemeBackdropTint" Color="#4A14151C"/>
    <sys:String x:Key="ThemeIndicatorStyle">dot</sys:String>
    <FontFamily x:Key="ThemeFontFamily">pack://application:,,,/Assets/Fonts/Inter/#Inter, Inter Medium, Inter SemiBold, Inter Display, Segoe UI Variable, Segoe UI</FontFamily>
    <CornerRadius x:Key="ThemePanelCornerRadius">26</CornerRadius>
    <sys:Double x:Key="ThemeIconSize">56</sys:Double>

    <!-- 三个指示样式键必须在每个主题字典里都存在：Style={DynamicResource} 解析不到键时元素会带着
         默认样式直接画出来（黑杠教训见 MacOS.xaml）。Aurora 用 dot；Bar/Underline 恒塌缩。 -->
    <Style x:Key="ThemeIndicatorDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Effect" Value="{DynamicResource AurIndicatorGlow}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Window">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <!-- 「一格 = 一个应用」合并后，固定项背后有在跑的窗口：它仍要亮运行点，
                 但不能把 Kind 改成 Window（那会换掉右键菜单并随窗口关闭而消失）。 -->
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ThemeIndicatorBar" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="ThemeIndicatorUnderline" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <!-- ══════════ Aur* 静态首帧值（暗色 + 签名青绿；运行时 AuroraTokenDictionary 全量覆写） ══════════ -->
    <!-- Level2 卡（卡 ≠ 面板，Adwaita Depth 层压语义） -->
    <SolidColorBrush x:Key="AurCardFill" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="AurCardFillHover" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="AurCardBorder" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="AurCardFillOn" Color="#592FD4B4"/>
    <SolidColorBrush x:Key="AurHoverTile" Color="#2BFFFFFF"/>
    <!-- Spotlight/菜单选中行：软填充 + 1px 发丝边 -->
    <SolidColorBrush x:Key="AurSelectionFill" Color="#3D2FD4B4"/>
    <SolidColorBrush x:Key="AurSelectionHairline" Color="#FF2FD4B4"/>
    <!-- 玻璃公式参数：中性基色（墙纸取色 tint 默认全透明 = 关，P2 工作包写入） -->
    <sys:String x:Key="AurGlassBase">#1E2027</sys:String>
    <SolidColorBrush x:Key="AurWallpaperTint" Color="#00000000"/>
    <!-- Dock 顶缘发丝线：hue(accent)@0xE6 → +38°@0x8C(0.45) → +95°@0x4D(0.8) → +95°@0x00(1.0) -->
    <LinearGradientBrush x:Key="AurHairlineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E62FD4B4" Offset="0"/>
        <GradientStop Color="#8C2F8BD4" Offset="0.45"/>
        <GradientStop Color="#4D6F2FD4" Offset="0.8"/>
        <GradientStop Color="#006F2FD4" Offset="1"/>
    </LinearGradientBrush>
    <!-- 弹层顶部内高光：mix(白,accent,0.18)@0x66 → 白@0x00 -->
    <LinearGradientBrush x:Key="AurInnerGlowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66DAF7F2" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- 运行指示点辉光（不 Freeze：换强调色要能跟着换；只用于指示点，Dock 逐帧热路径不涉 Effect） -->
    <DropShadowEffect x:Key="AurIndicatorGlow" BlurRadius="8" ShadowDepth="0" Color="#B32FD4B4"/>
    <!-- on-accent 派生（accent=#2FD4B4 首帧；L≤0.55 → 白字） -->
    <SolidColorBrush x:Key="AurAccentSoft" Color="#FF51DBC0"/>
    <SolidColorBrush x:Key="AurAccentText" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AurAccentGlow" Color="#B32FD4B4"/>
    <!-- 统一弹层底：「渲染恒为深色玻璃」旧裁定在 Aurora 放开，亮色走亮弹层底（运行时按外观覆写） -->
    <LinearGradientBrush x:Key="AurPopupFillSolid" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EE1B1D24" Offset="0"/>
        <GradientStop Color="#E617181E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AurPopupFillBlur" Color="#88131318"/>
    <!-- 媒体面板实心底（降级形态；运行时 AuroraTokenDictionary 按 Dark/Light token 覆写，
         macOS 兜底值由 MacTokenDictionary.Apply 写入） -->
    <LinearGradientBrush x:Key="AurMediaPanelFillSolid" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C81B1D24" Offset="0"/>
        <GradientStop Color="#D515171D" Offset="1"/>
    </LinearGradientBrush>
    <!-- Elevation 阴影（E2/E3 只给非 AppBar 约束浮层；Dock 被 AppBar 协商占满，用底缘渐变表达接地感） -->
    <DropShadowEffect x:Key="AurElevation1" BlurRadius="36" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.42"/>
    <DropShadowEffect x:Key="AurElevation2" BlurRadius="48" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.50"/>
    <DropShadowEffect x:Key="AurElevation3" BlurRadius="64" ShadowDepth="18" Direction="270" Color="#000000" Opacity="0.55"/>
    <!-- 微过冲弹簧曲线（WPF KeySpline y 允许超 1；当前为文档口径键，动画点映射见 tokenTable【6】） -->
    <sys:String x:Key="AurEaseSpring">cubic-bezier(0.34,1.56,0.64,1)</sys:String>
    <sys:Double x:Key="AurCardEnterMs">180</sys:Double>
</ResourceDictionary>
