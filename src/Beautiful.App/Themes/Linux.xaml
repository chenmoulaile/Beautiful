<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Linux(GNOME) 主题 token：#E61C1C1C 实底（BlurEnabled=false，亚克力禁用，无 blur tint）、
         左侧短条指示、圆角方形图标（遮罩矩形半径 8，由 ThemeManager 注入 ThemeIconClip）。
         原生 dash-to-dock 是**一条连续列表**（应用文件夹也并在同一列里）→ 无分隔符：
         ThemeDefinition.DockSeparatorsEnabled=false，DockViewModel 一条分隔符条目都不会生成。
         ThemeDockSeparatorFill 仍给出（模板共用，主题一旦开启也不会画成 invisible）。倒影同 macOS：无。 -->

    <SolidColorBrush x:Key="ThemeAccent" Color="#3584E4"/>
    <SolidColorBrush x:Key="ThemeDockBackground" Color="#E61C1C1C"/>
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ThemePanelBackground" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="ThemeDockSeparatorFill" Color="#33FFFFFF"/>
    <!-- 浮层主题 tint 覆盖层：本主题禁模糊（分层窗口自铺实底），tint 仍作为叠加层与另两主题区分 -->
    <SolidColorBrush x:Key="ThemeBackdropTint" Color="#4D1C1C1C"/>
    <sys:String x:Key="ThemeIndicatorStyle">bar</sys:String>
    <FontFamily x:Key="ThemeFontFamily">Segoe UI</FontFamily>
    <CornerRadius x:Key="ThemePanelCornerRadius">12</CornerRadius>
    <sys:Double x:Key="ThemeIconSize">44</sys:Double>

    <!-- 本主题无底部圆点 -->
    <Style x:Key="ThemeIndicatorDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <!-- 指示样式实作（bar）：图标左侧 3px 圆角短条，仅 Window 条目显示 -->
    <Style x:Key="ThemeIndicatorBar" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Window">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- 本主题不用"图标下方居中短横线"（那是 Windows 11 主题的指示语言）。
         键必须在每个主题字典里都存在：Style={DynamicResource} 解析不到键时元素会带着默认样式
         直接画出来，那就成了三个主题都多一条黑杠。 -->
    <Style x:Key="ThemeIndicatorUnderline" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
</ResourceDictionary>
