<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- HarmonyOS 主题 token（调研值）：默认深色玻璃（浅色变体 #59FFFFFF 由 Task 17 系统主题跟随提供）。
         ThemeIconClip（squircle 遮罩几何）由 ThemeManager 以 Superellipse 采样在运行时注入，勿在此声明。
         原生鸿蒙 dock 是连续列表 + 超级椭圆胶囊（圆角 28），**无分隔符、无倒影**：
         ThemeDefinition.DockSeparatorsEnabled=false / ReflectionDefault=false。 -->

    <!-- 鸿蒙蓝强调色：运行指示点 -->
    <SolidColorBrush x:Key="ThemeAccent" Color="#0A59F7"/>
    <!-- Dock 面板底色：38% 黑深色玻璃 -->
    <SolidColorBrush x:Key="ThemeDockBackground" Color="#61000000"/>
    <!-- 主文字色（深色玻璃上用白） -->
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#FFFFFFFF"/>
    <!-- 浮层面板（媒体胶囊）底色 -->
    <SolidColorBrush x:Key="ThemePanelBackground" Color="#26FFFFFF"/>
    <!-- 分隔符线色（本主题不生成分隔符条目，键留着让模板在主题开关改变时仍解析得到） -->
    <SolidColorBrush x:Key="ThemeDockSeparatorFill" Color="#33FFFFFF"/>
    <!-- 浮层（托盘菜单/媒体面板）主题 tint 覆盖层：Win11 系统背板（Mica/Acrylic）的取色由系统决定，
         应用写不进去 → 主题的 AcrylicTint（#61000000）改以内容层叠加体现，取 30% alpha 的叠加强度 -->
    <SolidColorBrush x:Key="ThemeBackdropTint" Color="#4D000000"/>
    <!-- 运行指示 token：底部圆点（dot | bar | none，与 ThemeDefinition.IndicatorStyle 对应） -->
    <sys:String x:Key="ThemeIndicatorStyle">dot</sys:String>
    <!-- 字体（FontFamily 类型实例：TextElement.FontFamily 附加属性不接受 String 资源；
         HarmonyOS Sans 缺失时回退，Task 17 附字体嵌入与授权声明） -->
    <FontFamily x:Key="ThemeFontFamily">HarmonyOS Sans, Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- 面板圆角 24-34 取 28 -->
    <CornerRadius x:Key="ThemePanelCornerRadius">28</CornerRadius>
    <sys:Double x:Key="ThemeIconSize">44</sys:Double>

    <!-- 指示样式实作（dot）：底部圆点，仅 Window 条目显示 -->
    <Style x:Key="ThemeIndicatorDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Window">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- 本主题无左侧短条 -->
    <Style x:Key="ThemeIndicatorBar" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource ThemeAccent}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
</ResourceDictionary>
