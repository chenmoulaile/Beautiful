<UserControl x:Class="Beautiful.App.TopBar.TrayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Ideal"
             FontFamily="{DynamicResource ThemeFontFamily}"
             Foreground="{DynamicResource ThemeTextPrimary}"
             AutomationProperties.Name="系统托盘图标面板">

    <!-- 顶栏"系统托盘图标区"（用户要求：像 Windows 自己的隐藏图标区那样，my dock finder 也做这个）。
         【材质与 WiFi 面板/控制中心完全同一套】Shell.Margin 那一圈是给自绘投影留位（宿主按 IPopupShadow
         把它从锚点偏移里扣掉），Card 圆角 + 亮边 + 投影，玻璃感来自宿主的抓屏模糊（IBackdropAware），
         拿不到模糊时铺 CardFillSolid 实心卡底 —— 分层窗口上"没画到"就是能看穿到桌面的洞。
         资源块的值与 ControlCenterPanel.xaml 同源，不另发明一套观感。
         【图标格全部由代码构建】每格的"有图/无图/能不能点/为什么不能点"都不同，写进 DataTemplate 的
         触发器比写在代码里更难读（同 WiFi 面板列表行的取舍）。 -->
    <UserControl.Resources>
        <!-- 有模糊时压在模糊之上的半透明深色遮罩：保证白字在任何壁纸上都有对比度 -->
        <LinearGradientBrush x:Key="CardFillBlur" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A232327" Offset="0"/>
            <GradientStop Color="#9919191C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardFillSolid" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F82C2C2F" Offset="0"/>
            <GradientStop Color="#FB1F1F23" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="32" ShadowDepth="9" Direction="270"
                          Color="#000000" Opacity="0.6"/>

        <!-- 一格托盘图标：40×40 圆角，透明底 + 悬停强调。图标下面不放文字——真实托盘本来就没有名字，
             加一行标签只会让用户以为那是应用名（名字在 ToolTip 里）。 -->
        <Style x:Key="TrayTileStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部动作与分页：透明底 + 悬停强调（与控制中心的底部动作同一观感） -->
        <Style x:Key="TrayFooterStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="7" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Shell" Margin="20,18,20,24">
        <Border x:Name="Card" Width="330" CornerRadius="12" BorderThickness="1" BorderBrush="#2AFFFFFF"
                Background="{StaticResource CardFillSolid}" Effect="{StaticResource CardShadow}">
            <Grid>
                <Border x:Name="Scrim" CornerRadius="11" IsHitTestVisible="False" Background="Transparent"/>
                <Border x:Name="TintLayer" CornerRadius="11" IsHitTestVisible="False"
                        Background="{DynamicResource ThemeBackdropTint}"/>
                <Border x:Name="InnerGlow" CornerRadius="11" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#05FFFFFF" Offset="0.35"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Margin="13,11,13,9">
                    <!-- 标题行：左"系统托盘图标"，右"N 个第三方图标 / 读取中…"（取不到就写读不到，不报假数字） -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="系统托盘图标" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HeaderStatus" HorizontalAlignment="Right" MaxWidth="150"
                                   FontSize="11.5" Opacity="0.72" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- 图标区：WrapPanel 平铺，格子由代码加进来。外面压一层极浅的底，
                         让"这是一片可点的格子"有边界（空态时整块收起，不留一个空框冒充有内容）。 -->
                    <Border x:Name="IconBand" CornerRadius="9" Background="#12FFFFFF" Padding="6,5">
                        <WrapPanel x:Name="IconHost"/>
                    </Border>

                    <!-- 空态：一行诚实文案（两路各自为什么读不到），绝不画一排假图标占位 -->
                    <TextBlock x:Name="EmptyLine" FontSize="11.5" Opacity="0.8" Margin="1,7,1,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- 分页：只有装不下一屏时才出现（一页 24 格，见 Core 的 DefaultPageSize） -->
                    <Grid x:Name="PageRow" Margin="0,5,0,0" Visibility="Collapsed">
                        <Button x:Name="PrevButton" Content="上一页" HorizontalAlignment="Left"
                                Style="{StaticResource TrayFooterStyle}" Click="Prev_Click"
                                AutomationProperties.Name="托盘图标 上一页"/>
                        <TextBlock x:Name="PageText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11.5" Opacity="0.72"/>
                        <Button x:Name="NextButton" Content="下一页" HorizontalAlignment="Right"
                                Style="{StaticResource TrayFooterStyle}" Click="Next_Click"
                                AutomationProperties.Name="托盘图标 下一页"/>
                    </Grid>

                    <!-- 状态/结果行：转发点击的结果、失败原因都写在这里，不弹系统气泡 -->
                    <TextBlock x:Name="StatusLine" FontSize="11" Opacity="0.8" Margin="1,7,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- 诊断行：两条路各自读到什么（"为什么这一格点不动"的第一手判据，真机排障入口） -->
                    <TextBlock x:Name="DiagLine" FontSize="10.5" Opacity="0.55" Margin="1,6,1,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Border Height="1" Background="#1AFFFFFF" Margin="1,8,1,0"/>

                    <Grid Margin="0,7,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="刷新" Style="{StaticResource TrayFooterStyle}" Click="Refresh_Click"
                                    AutomationProperties.Name="托盘图标 刷新"/>
                            <!-- 只在无障碍树真的认出那个按钮时才出现（不放只有一半能用的自建表单） -->
                            <Button x:Name="OverflowButton" Content="展开系统隐藏区…" Margin="3,0,0,0"
                                    Style="{StaticResource TrayFooterStyle}" Visibility="Collapsed"
                                    Click="Overflow_Click"
                                    ToolTip="由系统自己展开隐藏图标浮层；它一出现本面板就会关闭（前台只有一个）"
                                    AutomationProperties.Name="托盘图标 展开系统隐藏区"/>
                        </StackPanel>
                        <!-- 图标来源是别人的进程，读不到/点不动时唯一的真出路 -->
                        <Button Content="系统通知设置…" HorizontalAlignment="Right"
                                Style="{StaticResource TrayFooterStyle}" Click="OpenSettings_Click"
                                AutomationProperties.Name="托盘图标 打开系统通知设置"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
