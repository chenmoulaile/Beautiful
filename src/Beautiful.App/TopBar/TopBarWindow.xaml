<services:AcrylicWindow
        x:Class="Beautiful.App.TopBar.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Beautiful.App.Services"
        Title="Beautiful TopBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Focusable="False"
        Height="30">

    <!-- 形态（v3 T2/T3 裁定，替换 v2 的"非分层 + DWMWA_SYSTEMBACKDROP_TYPE 真背板"）：
         顶栏是**常驻**表面，不能做实时抓屏（重抓会把自身像素抓进背板 = 鬼影；为抓屏先隐藏一帧 = 闪烁），
         因此走"分层窗口 + 自绘半透明底 + best-effort 旧亚克力"：
         ① AllowsTransparency=True + Background={x:Null}：逐像素 alpha 由 WPF 自己保证，任何机型一致；
         ② BarBackground/BarGlow/BarEdge 三层把**整条矩形铺满**，条带内不得有一个未绘制像素——
            v2 真机"顶栏上方露一截壁纸"就是矩形里出现了没画到的那一块；
         ③ ApplyTintFallback 只请求系统侧模糊作增强（系统认账就有真模糊，不认账仍是②的自绘底，绝不黑）。
         主题值全部走 ThemeManager 合并字典 DynamicResource（换字典即时生效）；tint 与模糊开关在代码侧
         随 ThemeChanged 重刷（见 ApplyTheme）。 -->

    <!-- macOS 顶栏扁平按钮：透明底 + 悬停强调底色（ThemePanelBackground，DynamicResource 随主题）。
         左区菜单按钮与右区状态项共用；圆角 5 贴合系统菜单栏选中态。 -->
    <services:AcrylicWindow.Resources>
        <!-- 顶部内高光（macOS 菜单栏的"light top edge"）：只占条带上 40% 高度，越往下越淡。 -->
        <LinearGradientBrush x:Key="BarInnerGlow" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1AFFFFFF" Offset="0"/>
            <GradientStop Color="#07FFFFFF" Offset="0.4"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemePanelBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </services:AcrylicWindow.Resources>

    <Grid x:Name="RootHost"
          TextElement.FontFamily="{DynamicResource ThemeFontFamily}"
          TextElement.Foreground="{DynamicResource ThemeTextPrimary}">
        <!-- 三层自绘底铺满整条矩形（顺序即叠放顺序）：tint 底 → 顶部内高光 → 下缘 1px 亮边。
             全部 IsHitTestVisible=False 之外的命中交给按钮自身：这一层不做任何交互，只保证
             "条带矩形内没有一个未绘制像素"（分层窗口里未绘制 = 真透明 = 直接看穿到桌面）。 -->
        <Border x:Name="BarBackground" Background="{DynamicResource ThemeDockBackground}"/>
        <Border x:Name="BarGlow" IsHitTestVisible="False" Background="{StaticResource BarInnerGlow}"/>
        <Border x:Name="BarEdge" IsHitTestVisible="False" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1"
                VerticalAlignment="Stretch"/>

        <!-- ══ 左区（Task 9）：[logo 菜单按钮] + 前台应用名（粗体，macOS "应用菜单"位）+
             文件/编辑/视图/窗口/帮助 菜单按钮。logo 与菜单按钮由代码按 BarButton 样式注入 LeftHost，
             顺序：logo 前插到应用名之前，菜单按钮追加到应用名之后。 ══ -->
        <StackPanel x:Name="LeftHost" Orientation="Horizontal" HorizontalAlignment="Left"
                    VerticalAlignment="Stretch" Margin="10,0,0,0">
            <!-- 前台应用名：TopBarWindow.RefreshForegroundApp() 驱动（本任务保留、非交互，见代码注释） -->
            <TextBlock x:Name="ForegroundAppText" Text="Beautiful"
                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="2,0,8,0"/>
        </StackPanel>

        <!-- ══ 右区（Task 9）：状态项（媒体/时钟/音量/网络/电量）由代码注入 RightHost ══ -->
        <StackPanel x:Name="RightHost" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Stretch" Margin="0,0,10,0"/>
    </Grid>
</services:AcrylicWindow>
