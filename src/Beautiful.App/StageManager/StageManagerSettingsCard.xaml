<UserControl x:Class="Beautiful.App.StageManager.StageManagerSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- 台前调度设置卡（wp-macos-parity r5）：独立 UserControl，自包含样式——不依赖设置窗口
         宿主的 HintText 等内部资源，宿主把它插进任意面板即可用（接线契约见该类型的 settingsContract）。
         开关行为自足：勾选 → 写 settings.json（StageManagerEnabled）→ 调 App.ApplyStageManager()
         立即生效，宿主不需要写任何事件处理代码。 -->

    <UserControl.Resources>
        <Style x:Key="StageHintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <CheckBox x:Name="EnabledCheck" Content="台前调度（每屏一条舞台条）"
                  Checked="OnToggleChanged" Unchecked="OnToggleChanged"/>
        <CheckBox x:Name="SlideCheck" Content="展开/收起使用滑动动画（时长与缓动跟随主题动效）"
                  Margin="0,6,0,0"
                  Checked="OnSlideToggleChanged" Unchecked="OnSlideToggleChanged"/>
        <TextBlock Style="{StaticResource StageHintText}" Margin="0,5,0,0"
                   Text="对标 macOS 台前调度：每块显示器的左缘各常驻一条收起的舞台条，鼠标靠近整条滑出。卡片显示各应用最近窗口的实况缩略图（DWM 合成，不抓帧），点击即切到该窗口，最小化的窗口自动还原；同应用开了多个窗口时，点卡片会展开该组的全部窗口列，再点选要去的那个。当前前台应用所在屏的卡片带强调色描边。鼠标离开或切换成功后自动收回，按 Esc 随时全局收起；前台为真全屏（游戏/视频）时该屏的条整条让位。"/>
    </StackPanel>
</UserControl>
