<Window x:Class="Beautiful.App.StageManager.StageGroupFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beautiful Stage Manager Windows"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="True" IsTabStop="False"
        Topmost="True" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Width="236" Height="122"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{DynamicResource ThemeFontFamily}">

    <!-- 台前调度·二级弹层（wp-macos-parity r6）：同应用多窗时点卡片弹出的"窗口列"。
         与舞台条同一宿主血统（WPF 分层窗口；行画面同走 StageFramePump 静帧链——
         round5 真机实拍 DWM 玻璃弹层注册全 0 却不合成像素，取证见 StageBarWindow.xaml 头注释）。
         每行 = 图标 + 窗口标题 + 静帧缩略区；点行即切到该窗口（最小化自动还原）。
         样式：卡底/缩略底色自包含（与舞台条同源拷贝，拷贝而非合并键：两窗各自独立分层），
         内高光改读统一弹层键 AurInnerGlowBrush（StageBarWindow 同款；两主题运行时都有值，
         详见 StageBarWindow.xaml 头注释"内高光改读 AurInnerGlowBrush"），
         另依赖全局主题键 ThemeBackdropTint / ThemeTextPrimary / ThemeFontFamily 与应用级图形 SymbolApps。 -->

    <Window.Resources>
        <!-- 与 StageBarWindow 同源的卡底/缩略底色（拷贝而非合并键：两窗各自独立分层）。 -->
        <LinearGradientBrush x:Key="StageCardFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F62C2C2F" Offset="0"/>
            <GradientStop Color="#FA1B1B1F" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="StageThumbBackdrop" Color="#FF101013"/>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="12" Background="{StaticResource StageCardFill}"
            BorderBrush="#26FFFFFF" BorderThickness="1" Padding="8">
        <Grid>
            <Border IsHitTestVisible="False" Background="{DynamicResource ThemeBackdropTint}"/>
            <Border IsHitTestVisible="False" Background="{DynamicResource AurInnerGlowBrush}"/>

            <!-- 窗口行：每"组内窗口"一行。数量上限由宿主按工作区高度与 MaxRows 夹定（无滚动）。 -->
            <ItemsControl x:Name="RowsControl" Focusable="False" IsHitTestVisible="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="WindowRow" CornerRadius="10" Margin="0,0,0,8"
                                Background="#14FFFFFF" BorderThickness="1.5" BorderBrush="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonUp="Row_Click">
                            <StackPanel>
                                <!-- 窗口行头：应用图标 + 窗口标题（最小化窗口带后缀） -->
                                <StackPanel Orientation="Horizontal" Margin="8,6,8,4">
                                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                                        <Image x:Name="Icon" Source="{Binding Icon}" Width="14" Height="14"
                                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Path x:Name="Fallback" Data="{StaticResource SymbolApps}"
                                              Width="11" Height="11" Stretch="Uniform"
                                              Stroke="#9AFFFFFF" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Fill="Transparent" Visibility="Collapsed"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding TitleLabel}" FontSize="11" Margin="6,0,0,0"
                                               MaxWidth="190" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                                </StackPanel>
                                <!-- 缩略画面区：StageFramePump 抓到的源窗口静帧（round5 缺陷 4 后
                                     DWM 实况弹层退役）；没抓到帧时 Source 为 null，露占位底色 -->
                                <Border x:Name="ThumbArea" Height="64" Margin="7,0,7,7" CornerRadius="4"
                                        Background="{StaticResource StageThumbBackdrop}">
                                    <Image Source="{Binding Frame}" Stretch="Uniform" Margin="3"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Fallback" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
