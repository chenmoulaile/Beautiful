<Window x:Class="Beautiful.App.StageManager.StageBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beautiful Stage Manager"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="True" IsTabStop="False"
        Topmost="True" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Width="196" Height="159"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{DynamicResource ThemeFontFamily}">

    <!-- 台前调度·左侧舞台条（wp-macos-parity r5）：贴左缘常驻、收起只露 6 DIP 贴边小条，
         鼠标靠近整条滑出，离开/失焦延时收回（自动隐藏语义本体）。
         【为什么必须是分层窗口】真机取证（Finder/QuickLookWindow.xaml 头注释）：这台真机
         （Win11 26300）上 WPF 非分层窗口整机黑屏，只有分层窗口（Dock/顶栏/切换器同款路径）
         能出画面——圆角因此由根 Border 的 CornerRadius 自绘（与切换面板同法），不依赖 DWM 圆角。
         【实况缩略图为什么不在本窗口上】分层窗口（WS_EX_LAYERED）上 DWM 缩略图不合成
         （ThumbnailPreview 头注释的硬条件），所以实时画面落在独立玻璃弹层
         （StageThumbHostWindow，owner=本窗口，浮在缩略图列正上方）。卡片的 ThumbArea
         只是占位底色：弹层玻璃透出它，DWM 正常合成时实况画面覆盖它，两种结局都无黑框。
         【样式自包含】卡片渐变/内高光/占位底色都在本文件 Window.Resources 里，不依赖宿主主题
         键（ThemeAccent / ThemeFontFamily 除外——它们是全局主题键，与 Dock/切换器同一取色口径）。 -->

    <Window.Resources>
        <!-- 卡底：与切换面板同一视觉语言的实心渐变（分层窗口上"没画到"= 看穿到桌面，绝不允许）。 -->
        <LinearGradientBrush x:Key="StageCardFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F62C2C2F" Offset="0"/>
            <GradientStop Color="#FA1B1B1F" Offset="1"/>
        </LinearGradientBrush>
        <!-- 顶部内高光：macOS 玻璃感的 "light top edge"（与 FluentMenu / 切换面板同一视觉语言） -->
        <LinearGradientBrush x:Key="StageInnerGlow" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#19FFFFFF" Offset="0"/>
            <GradientStop Color="#06FFFFFF" Offset="0.42"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <!-- 缩略图预留区底色：DWM 实况画面之下的一层（注册失败/不合成时的"空位"观感） -->
        <SolidColorBrush x:Key="StageThumbBackdrop" Color="#FF101013"/>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="12" Background="{StaticResource StageCardFill}"
            BorderBrush="#26FFFFFF" BorderThickness="1" Padding="8">
        <Grid>
            <!-- 叠放顺序即材质顺序：卡底渐变 → 主题 tint → 内高光 → 卡片列表 -->
            <Border IsHitTestVisible="False" Background="{DynamicResource ThemeBackdropTint}"/>
            <Border IsHitTestVisible="False" Background="{StaticResource StageInnerGlow}"/>

            <!-- 卡片列：每"应用组"一张卡。数量上限 = StageGrouper.DefaultMaxGroups，
                 且按显示器工作区高度再夹一道（超出按 MRU 丢弃，下拍对账自然回来）。 -->
            <ItemsControl x:Name="Cards" Focusable="False" IsHitTestVisible="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="GroupCard" CornerRadius="10" Margin="0,0,0,8"
                                Background="#14FFFFFF" BorderThickness="1.5" BorderBrush="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonUp="GroupCard_Click">
                            <StackPanel>
                                <!-- 应用行：图标 + 名称（多窗口时带计数）；当前前台组由 DataTrigger 换强调描边 -->
                                <StackPanel Orientation="Horizontal" Margin="8,7,8,5">
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <Image x:Name="Icon" Source="{Binding Icon}" Width="16" Height="16"
                                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Path x:Name="Fallback" Data="{StaticResource SymbolApps}"
                                              Width="13" Height="13" Stretch="Uniform"
                                              Stroke="#9AFFFFFF" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Fill="Transparent" Visibility="Collapsed"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding CountLabel}" FontSize="11.5" Margin="6,0,0,0"
                                               MaxWidth="150" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                                </StackPanel>
                                <!-- 实况缩略图预留区：矩形交给 DWM 合成（StageThumbStrip），
                                     里面不排 WPF 内容（层叠规则见文件头注释） -->
                                <Border x:Name="ThumbArea" Height="100" Margin="7,0,7,7" CornerRadius="4"
                                        Background="{StaticResource StageThumbBackdrop}"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Fallback" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- 当前前台应用所在组：强调色描边 + 提亮底（高亮位，macOS 台前调度语义） -->
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="GroupCard" Property="BorderBrush"
                                        Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="GroupCard" Property="Background" Value="#2EFFFFFF"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
