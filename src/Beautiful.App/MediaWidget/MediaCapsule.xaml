<UserControl x:Class="Beautiful.App.MediaWidget.MediaCapsule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 鸿蒙"实况窗"胶囊：深色半透明底白字，圆角 = Height/2（32/2 = 16）。
         可见性由 DataContext（MediaViewModel）.HasSession 驱动：无会话 → Collapsed。
         跑马灯视口 MarqueeHost（ClipToBounds）内 TextBlock 经 TranslateTransform.X 往复滚动，
         未溢出时静态（动画由 code-behind 按溢出量启停）。 -->
    <UserControl.Resources>
        <Style x:Key="CapsulePlayButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="13" Background="Transparent">
                            <!-- 播放/暂停：Symbols.xaml 矢量几何随 IsPlaying 切换（macOS 化 r4
                                 替代 Segoe \uE768/\uE769 码点）；模板按实例展开，无元素共享问题。 -->
                            <Grid>
                                <Path x:Name="PlayIcon" Data="{StaticResource SymbolPlay}"
                                      Width="11" Height="11" Stretch="Uniform" Fill="Transparent"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stroke="{TemplateBinding Foreground}"/>
                                <Path x:Name="PauseIcon" Data="{StaticResource SymbolPause}"
                                      Width="11" Height="11" Stretch="Uniform" Fill="Transparent"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stroke="{TemplateBinding Foreground}"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="PlayIcon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PauseIcon" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="PillRoot" Height="32" CornerRadius="16"
            Background="#88000000" BorderBrush="#22FFFFFF" BorderThickness="1"
            Padding="12,0,4,0" Cursor="Hand">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasSession}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="MarqueeHost" ClipToBounds="True" VerticalAlignment="Center">
                <TextBlock x:Name="MarqueeText" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource ThemeTextPrimary}"
                           Text="{Binding CapsuleText, NotifyOnTargetUpdated=True}">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MarqueeTf"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Border>
            <Button x:Name="PlayPauseButton" Grid.Column="1" Margin="6,0,0,0"
                    Style="{StaticResource CapsulePlayButton}"
                    Command="{Binding TogglePlayCommand}"/>
        </Grid>
    </Border>
</UserControl>
