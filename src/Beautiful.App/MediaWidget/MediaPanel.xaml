<services:AcrylicWindow x:Class="Beautiful.App.MediaWidget.MediaPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Beautiful.App.Services"
        Title="NowPlaying"
        Width="420" Height="300"
        Topmost="True"
        ShowActivated="True"
        Background="{x:Null}"
        WindowStartupLocation="Manual">

    <!-- 正在播放面板（实况窗大窗）：胶囊上方居中（定位由 DockWindow 计算）。
         失焦自动 Hide（Deactivated → code-behind，开关 = HidePanelOnDeactivate 设置项）。
         v4（Phase 1 T2）：面板只保留封面/标题/进度/三键，即 macOS "正在播放"语义。
         【v3 T2/T3 形态】恒为分层窗口（基类 AcrylicWindow 已置 AllowsTransparency=True）：
         20px 圆角与 1px 亮边由 PanelRoot 自绘，逐像素 alpha 由 WPF 保证。v2 那句"启用模糊的主题转
         非分层 + Win11 系统背板、圆角交 DWM 裁切"连同它的两个分支一起删除——真机上那条路径画不出
         背板，只会让面板出现硬边黑块（v3 §1.B）。窗口底维持 {x:Null}：圆角缺口是真透明，
         点击落到底下的桌面而不是我们（分层窗口里"未绘制不参与命中测试"）。
         玻璃感 = 显示前抓屏自绘模糊（code-behind 的 RefreshBackdrop，由 DockWindow 在 Show 之前调用）；
         抓不到就回落主题实心底 AurMediaPanelFillSolid（Aur* 弹层语义键：macOS 兜底值 =
         MediaPanel 原就地硬编码同值 #C81C1C1E→#D5171719，Aurora 按 Dark/Light token 给暗/亮玻璃；
         GradientStop 上挂不了 DynamicResource，所以整支渐变进主题字典，本文件不存局部拷贝），
         两条分支都铺满整张卡。 -->
    <services:AcrylicWindow.Resources>
        <!-- 抓屏模糊之上的遮罩：半透明深色渐变，负责标题的文字对比度 -->
        <LinearGradientBrush x:Key="PanelFillBlur" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8C1C1C1E" Offset="0"/>
            <GradientStop Color="#99171719" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 播放/暂停：Symbols.xaml 矢量几何随 IsPlaying 切换（macOS 化 r4 替代 Segoe \uE768/\uE769 码点）。
             双 Path 都放在模板里由 DataTrigger 切可见性——模板按 Button 实例展开，
             避免旧做法（Style Setter 提供 Content 元素）在多实例间的元素共享问题。 -->
        <Style x:Key="PlayPauseButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                            <Grid>
                                <Path x:Name="PlayIcon" Data="{StaticResource SymbolPlay}"
                                      Width="18" Height="18" Stretch="Uniform" Fill="Transparent"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stroke="{TemplateBinding Foreground}"/>
                                <Path x:Name="PauseIcon" Data="{StaticResource SymbolPause}"
                                      Width="18" Height="18" Stretch="Uniform" Fill="Transparent"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stroke="{TemplateBinding Foreground}"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="PlayIcon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PauseIcon" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </services:AcrylicWindow.Resources>

    <Border x:Name="PanelRoot" CornerRadius="20" Background="{DynamicResource AurMediaPanelFillSolid}"
            BorderBrush="#33FFFFFF" BorderThickness="1"
            Padding="20,18" TextElement.FontFamily="{DynamicResource ThemeFontFamily}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 叠放顺序即材质顺序：抓屏模糊（PanelRoot.Background）→ Scrim 深色遮罩 → 主题 tint → 内容。
                 负 Margin 精确抵掉 PanelRoot 的 Padding="20,18"，使这两层铺满整张卡（含四周留白）。
                 IsHitTestVisible=False：只做着色，不抢控件命中。 -->
            <Border x:Name="Scrim" Grid.RowSpan="3" Margin="-20,-18" CornerRadius="19"
                    IsHitTestVisible="False" Background="Transparent"/>
            <!-- 主题 tint 覆盖层：随 DynamicResource 即时体现主题色（换主题即变色，无需代码重刷）。 -->
            <Border x:Name="TintLayer" Grid.RowSpan="3" Margin="-20,-18" CornerRadius="19"
                    IsHitTestVisible="False" Background="{DynamicResource ThemeBackdropTint}"/>

            <!-- 封面 + 标题/歌手 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="64" Height="64">
                    <Border CornerRadius="8" Background="#1FFFFFFF"/>
                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" Width="64" Height="64"/>
                    <!-- 封面缺失回退音符 -->
                    <TextBlock Text="&#x266A;" FontSize="28" Opacity="0.5"
                               Foreground="{DynamicResource ThemeTextPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TrackTitle}" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeTextPrimary}"/>
                    <TextBlock Text="{Binding Artist}" FontSize="13" Opacity="0.7" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeTextPrimary}"/>
                </StackPanel>
            </Grid>

            <!-- 进度条：不支持位置控制（SeekAsync 首次失败 → IsSeekable=false）→ 隐藏。
                 Value 单向：VM → Slider；Slider → VM 的回传不需要（EndSeek 直读 Progress.Value），
                 且 PositionSeconds 为只读属性，TwoWay 会在 Show 时抛只读绑定异常。 -->
            <Slider x:Name="Progress" Grid.Row="1" Margin="0,14,0,0"
                    IsMoveToPointEnabled="True" Minimum="0"
                    Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}">
                <Slider.Style>
                    <Style TargetType="Slider">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSeekable}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Slider.Style>
            </Slider>

            <!-- 上一首 / 播放暂停 / 下一首：Symbols.xaml 矢量几何（macOS 化 r4 替代 Segoe E9AB/E768/E9AA 码点）；
                 描边随按钮前景色走（主题切换/置灰同色）。 -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
                <Button Style="{StaticResource TransportButtonStyle}" Command="{Binding PrevCommand}"
                        AutomationProperties.Name="上一首">
                    <Path Data="{StaticResource SymbolPrev}" Width="18" Height="18" Stretch="Uniform"
                          Fill="Transparent" StrokeThickness="1.8" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource PlayPauseButtonStyle}" Command="{Binding TogglePlayCommand}"
                        AutomationProperties.Name="播放或暂停"/>
                <Button Style="{StaticResource TransportButtonStyle}" Command="{Binding NextCommand}"
                        AutomationProperties.Name="下一首">
                    <Path Data="{StaticResource SymbolNext}" Width="18" Height="18" Stretch="Uniform"
                          Fill="Transparent" StrokeThickness="1.8" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</services:AcrylicWindow>
