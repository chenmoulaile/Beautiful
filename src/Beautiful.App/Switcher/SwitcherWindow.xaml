<Window x:Class="Beautiful.App.Switcher.SwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Beautiful Switcher"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="Manual"
        AllowsTransparency="False" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" IsTabStop="False"
        Topmost="True" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{DynamicResource ThemeFontFamily}">

    <!-- Alt+Tab 可见切换面板（Task 12）：只渲染 SwitcherService 的状态机，自身不枚举窗口、不切前台。
         【非激活式，与 FluentPopupHost 相反】ShowActivated=False + Focusable=False + WS_EX_NOACTIVATE。
         Alt 仍被用户按着：面板若夺前台会打断修饰键状态机（系统可能据此认为会话结束），并且面板自己
         成了前台 → 随后 Commit 的目标就成了我们的面板窗口。按键全部来自全局低级键盘钩子（不依赖焦点），
         所以这里既不需要键盘可达，也绝不能键盘可达。
         【真背板】AllowsTransparency=False（分层窗口与 DWM 背板互斥），形状由 SetWindowRgn 裁切：
         DWMWA_WINDOW_CORNER_PREFERENCE 只有系统那一种半径（约 8 物理 px），画不出 macOS 大圆角与
         鸿蒙胶囊；区域半径随样式给，内容三层（卡底 / 主题 tint / 顶部内高光）铺满整个窗口。
         【样式】差异收敛为两处：模板经 DynamicResource 取 SwitcherIconSize / SwitcherTileRadius /
         SwitcherAccent / SwitcherIconClip（图标遮罩几何，macOS 样式删键 → 不遮罩）；卡片半径、内边距、
         字幕可见性、条目间距等不在模板里的，由 ApplyStyle() 直接赋值（无资源间接层，少一处易错点）。 -->

    <Window.Resources>
        <!-- 卡底：真背板可用时半透明（让系统模糊透出），三档全败时自铺实底（非分层窗口没有逐像素
             alpha，半透明只会露出黑区 → 与 FluentMenu 同一"降级不得画成黑卡"约束） -->
        <LinearGradientBrush x:Key="CardFillBlur" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A232327" Offset="0"/>
            <GradientStop Color="#9A19191C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardFillSolid" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F62C2C2F" Offset="0"/>
            <GradientStop Color="#FA1B1B1F" Offset="1"/>
        </LinearGradientBrush>
        <!-- 顶部内高光：macOS 玻璃感的"light top edge"（与 FluentMenu 同一视觉语言） -->
        <LinearGradientBrush x:Key="CardInnerGlow" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#19FFFFFF" Offset="0"/>
            <GradientStop Color="#06FFFFFF" Offset="0.42"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- 默认值 = macOS 样式（AppSettings.SwitcherStyle 默认值）；ApplyStyle 每次显示前覆盖 -->
        <sys:Double x:Key="SwitcherIconSize">56</sys:Double>
        <sys:Double x:Key="SwitcherSubIconSize">18</sys:Double>
        <Thickness x:Key="SwitcherTilePadding">7</Thickness>
        <CornerRadius x:Key="SwitcherTileRadius">14</CornerRadius>
        <SolidColorBrush x:Key="SwitcherAccent" Color="#0A84FF"/>
        <!-- SwitcherIconClip（图标遮罩几何）不写默认值：缺键 → DynamicResource 不解析 → Clip=null -->
    </Window.Resources>

    <Border x:Name="Card" Background="{StaticResource CardFillBlur}" CornerRadius="18">
        <Grid>
            <!-- 主题 tint 覆盖层：系统背板（档 1/2）不认我们的 tint，只能作为内容层叠加体现主题 -->
            <Border x:Name="TintLayer" IsHitTestVisible="False"
                    Background="{DynamicResource ThemeBackdropTint}"/>
            <Border x:Name="GlowLayer" IsHitTestVisible="False" Background="{StaticResource CardInnerGlow}"/>

            <StackPanel x:Name="Body" Margin="16,13,16,13">
                <!-- App 图标行：每 App 一瓦片；高亮唯一来源 = 服务的 SelectedAppIndex → IsSelected，
                     键盘步进与鼠标悬停共用同一条动画（110ms 淡入 + 0.9→1 缩放） -->
                <ItemsControl x:Name="AppRow" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 高亮 = 瓦片自身的底色 + 强调色描边（Setter 直给，不靠动画）：
                                 瓦片盒 = 图标 + Padding + 恒定 2px 边框宽（选中只换颜色，尺寸不变→整行不抖）。
                                 曾经用两个叠层 Border + Opacity 动画做高亮，实测图标 56×56 正好铺满叠层盒，
                                 高亮被图标本体盖住看不见；改回 Border 背景/描边后一次到位。
                                 动画只保留图标的 1.06 弹跳（macOS 选中感）。 -->
                            <Border x:Name="Tile" Padding="{DynamicResource SwitcherTilePadding}"
                                    CornerRadius="{DynamicResource SwitcherTileRadius}"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                                    Cursor="Hand"
                                    MouseEnter="Tile_MouseEnter" MouseLeftButtonUp="Tile_MouseClick">
                                <Grid>
                                    <!-- 图标遮罩：macOS 原样 / Linux 圆角方形 / 鸿蒙 squircle，
                                         几何按当前样式图标尺寸由 ApplyStyle 生成（键删除即不遮罩） -->
                                    <Image x:Name="Icon" Source="{Binding Icon}"
                                           Width="{DynamicResource SwitcherIconSize}"
                                           Height="{DynamicResource SwitcherIconSize}"
                                           Stretch="Uniform" Clip="{DynamicResource SwitcherIconClip}"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image.RenderTransform>
                                            <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
                                        </Image.RenderTransform>
                                        <Image.RenderTransformOrigin>
                                            <Point X="0.5" Y="0.5"/>
                                        </Image.RenderTransformOrigin>
                                    </Image>
                                    <TextBlock x:Name="Fallback" Text="&#xE7EF;" FontSize="26"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="#9AFFFFFF" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Fallback" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- 单一高亮来源：服务的 SelectedAppIndex → 瓦片 IsSelected，
                                     键盘步进与鼠标悬停走同一条路径 -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="#33FFFFFF"/>
                                    <Setter TargetName="Tile" Property="BorderBrush"
                                            Value="{DynamicResource SwitcherAccent}"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1.06" Duration="0:0:0.11">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1.06" Duration="0:0:0.11">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 字幕（macOS 语义：整行共用一条居中字幕，只写当前选中应用；Linux 样式隐藏）。
                     展开多窗口后追加所选窗口标题，让"选到哪个窗口"可见。 -->
                <TextBlock x:Name="Caption" Text="" Margin="0,11,0,0" FontSize="13"
                           MaxWidth="720" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimary}"/>

                <!-- 多窗口展开行（macOS 二次 Tab 语义）：更小瓦片 + 窗口标题，悬停移动高亮、点击提交 -->
                <ItemsControl x:Name="WindowRow" Focusable="False" Margin="0,12,0,0" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="SubTile" Padding="8,4" CornerRadius="9"
                                    Background="#1AFFFFFF" BorderThickness="1.5" BorderBrush="Transparent"
                                    Cursor="Hand"
                                    MouseEnter="SubTile_MouseEnter" MouseLeftButtonUp="SubTile_MouseClick">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="{DynamicResource SwitcherSubIconSize}"
                                           Height="{DynamicResource SwitcherSubIconSize}" Stretch="Uniform"
                                           Clip="{DynamicResource SwitcherIconClip}" Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Title}" FontSize="11.5" MaxWidth="200"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="SubTile" Property="Background" Value="#33FFFFFF"/>
                                    <Setter TargetName="SubTile" Property="BorderBrush"
                                            Value="{DynamicResource SwitcherAccent}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</Window>
