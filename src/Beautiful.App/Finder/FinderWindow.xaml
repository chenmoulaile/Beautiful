<Window x:Class="Beautiful.App.Finder.FinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="访达" Width="1100" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource MacWindowBackground}"
        Foreground="{DynamicResource MacTextPrimary}"
        FontFamily="{DynamicResource MacFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Phase 6-a 访达骨架（Big Sur 风格）。非分层窗口：AllowsTransparency 保持 false，
         WindowChrome 走非分层路径，ClearType / DWM 阴影 / DWM 圆角全部保留（见代码后置
         OnSourceInitialized 的 corner=2）。CaptionHeight=0 时整条工具栏由自绘 MouseLeftButtonDown
         承担拖动；左侧三点颜色/行为与 SettingsWindow 的交通灯一致。 -->
    <chrome:WindowChrome.WindowChrome>
        <chrome:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                             GlassFrameThickness="0" CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </chrome:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 交通灯：常态只有色点，悬停浮出内部刻痕；窗口失焦时统一退灰（与设置窗口同一套观感）。 -->
        <Style x:Key="TrafficDot" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#FF5F57"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="14" Height="14" Background="Transparent">
                            <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}"
                                     Stroke="#26000000" StrokeThickness="0.5"/>
                            <ContentPresenter x:Name="Glyph" Opacity="0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter TargetName="Dot" Property="Fill" Value="#FFB0B0B0"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DotGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="#8A000000"/>
            <Setter Property="StrokeThickness" Value="1.2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <!-- 工具栏图标按钮：透明底 + 悬停浅灰圆角块，保持 macOS 工具栏的轻量感。 -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MacTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏项：选中/悬停都画在圆角底上，不借用系统蓝色高亮（深色主题下会刺眼）。 -->
        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="{DynamicResource MacTextPrimary}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20007AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表头：透明底 + 发丝下边线；列头不做排序（排序口径已由 Core FinderSorting 固化）。 -->
        <Style x:Key="FinderHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MacTextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource MacSeparator}" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行容器：24px 行高、整行命中的选中/悬停底色。
             自定义模板必须保留 GridViewRowPresenter，否则 GridView 的列布局不会生效。 -->
        <Style x:Key="FinderRow" TargetType="ListViewItem">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource MacTextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20007AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource MacWindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ============ 工具栏（标题栏） ============ -->
        <Border Grid.Row="0" Background="#14808080" BorderBrush="#22808080" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="13,0,13,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CloseDot" Style="{StaticResource TrafficDot}"
                            Background="#FFFF5F57" ToolTip="关闭" Click="Close_Click">
                        <Path Style="{StaticResource DotGlyph}" Data="M3,3 L11,11 M11,3 L3,11"/>
                    </Button>
                    <Button x:Name="MinDot" Style="{StaticResource TrafficDot}"
                            Background="#FFFEBC2E" ToolTip="最小化" Click="Minimize_Click">
                        <Path Style="{StaticResource DotGlyph}" Data="M3.5,7 L10.5,7"/>
                    </Button>
                    <Button x:Name="ZoomDot" Style="{StaticResource TrafficDot}" Margin="0"
                            Background="#FF28C840" ToolTip="最大化 / 还原" Click="Zoom_Click">
                        <Path Style="{StaticResource DotGlyph}" Data="M3.5,8.5 L3.5,3.5 L8.5,3.5 M10.5,5.5 L10.5,10.5 L5.5,10.5"/>
                    </Button>

                    <Border Width="1" Height="18" Background="#22808080" Margin="9,0,7,0"/>

                    <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Content="‹"
                            FontSize="20" ToolTip="后退 (Ctrl+[)" Click="Back_Click" IsEnabled="False"/>
                    <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}" Content="›"
                            FontSize="20" ToolTip="前进 (Ctrl+])" Click="Forward_Click" IsEnabled="False"/>
                </StackPanel>

                <!-- 当前路径：居中、过长省略；完整路径在 ToolTip 里。 -->
                <TextBlock x:Name="PathText" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="12,0" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="220" Height="24" Margin="0,0,8,0">
                        <TextBox x:Name="SearchBox" FontSize="12" Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 Background="#0A808080" BorderBrush="#22808080"
                                 Foreground="{DynamicResource MacTextPrimary}"
                                 CaretBrush="{DynamicResource MacTextPrimary}"
                                 ToolTip="按名称筛选当前文件夹"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索" FontSize="12"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MacTextTertiary}"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <Button x:Name="ListViewButton" Style="{StaticResource ToolButton}" Content="≣"
                            FontSize="14" ToolTip="列表视图（当前）" Click="List_Click"/>
                    <Button x:Name="ColumnsButton" Style="{StaticResource ToolButton}" Content="▥"
                            FontSize="14" ToolTip="Phase 6-b 实现" Click="DeferredView_Click"/>
                    <Button x:Name="GridButton" Style="{StaticResource ToolButton}" Content="▦"
                            FontSize="14" ToolTip="Phase 6-b 实现" Click="DeferredView_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 侧栏 + 文件列表 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0A808080"
                    BorderBrush="#22808080" BorderThickness="0,0,1,0">
                <ListBox x:Name="Sidebar" Margin="10,10,10,10" Background="Transparent"
                         BorderThickness="0" FontSize="12"
                         DisplayMemberPath="Label"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="Sidebar_SelectionChanged"/>
            </Border>

            <ListView x:Name="FileList" Grid.Column="1" Background="Transparent"
                      BorderThickness="0" FontSize="12" Padding="0,4,0,0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource FinderRow}">
                        <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource FinderHeader}">
                        <GridViewColumn x:Name="NameColumn" Header="名称" Width="380">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="16" Height="16" HorizontalAlignment="Left"
                                              VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Glyph}" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MacTextSecondary}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="修改日期" Width="150"
                                        DisplayMemberBinding="{Binding ModifiedText}"/>
                        <GridViewColumn Header="大小" Width="90"
                                        DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="种类" Width="110"
                                        DisplayMemberBinding="{Binding KindText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="2" Background="#0A808080"
                BorderBrush="#22808080" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Margin="12,0" VerticalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource MacTextSecondary}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
