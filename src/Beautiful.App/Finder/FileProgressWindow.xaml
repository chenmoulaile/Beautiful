<Window x:Class="Beautiful.App.Finder.FileProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="正在拷贝" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource MacWindowBackground}"
        Foreground="{DynamicResource MacTextPrimary}"
        FontFamily="{DynamicResource MacFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Phase 6-c macOS 风格进度卡：非分层窗口 + WindowChrome + DWM 圆角（与访达/Quick Look 同一纪律）。
         无红绿灯（macOS 的拷贝进度窗也没有关闭按钮），只有"停止"；完成后自动关闭，失败时换成"关闭"。 -->
    <chrome:WindowChrome.WindowChrome>
        <chrome:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                             GlassFrameThickness="0" CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </chrome:WindowChrome.WindowChrome>

    <Border Padding="20,16,20,16" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="正在拷贝…" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock x:Name="DetailText" Text="" FontSize="11" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MacTextSecondary}"/>

            <ProgressBar x:Name="Bar" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="1"
                         Background="#1A808080" BorderThickness="0"
                         Foreground="#FF007AFF"/>

            <Grid Margin="0,10,0,0">
                <TextBlock x:Name="CountText" Text="" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource MacTextTertiary}"/>
                <Button x:Name="ActionButton" Content="停止" HorizontalAlignment="Right"
                        MinWidth="64" Height="24" Padding="12,0" FontSize="11.5"
                        Background="#14808080" BorderThickness="0" Click="Action_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#24808080"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
