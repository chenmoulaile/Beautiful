<UserControl x:Class="Beautiful.App.Launcher.LauncherOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False"
             AutomationProperties.Name="启动器面板"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             FontFamily="{DynamicResource ThemeFontFamily}"
             Foreground="{DynamicResource ThemeTextPrimary}">

    <!-- Spotlight 式启动器覆盖层（v3 T7）。
         【材质与托盘菜单/控制中心同源】宿主是 FluentPopupHost（分层窗口 + 显示前抓屏模糊），
         叠放顺序 = Card.Background（抓屏模糊或实心卡底）→ Scrim（有模糊时压深色遮罩保对比）→
         TintLayer（ThemeBackdropTint）→ InnerGlow（顶部内高光）。Shell.Margin 给自绘投影留位：
         分层窗口上"没画到"就是能看穿到桌面的洞，两条分支都必须铺满整张卡。
         【Spotlight 调校】卡底透明度比托盘菜单/控制中心更低、圆角更大、搜索框与结果行更高，
         贴近 macOS Spotlight 的半透明深色玻璃；两份卡底画刷仍按同一结构就地定义（不抽公共字典，
         抽出来要改已在用的 FluentMenu.xaml / ControlCenterPanel.xaml，而 brief 明确不许动既有面板）。
         【Card 定宽 + 内部星号行】宿主按 Measure(inf,inf) 同步量尺寸来决定落位与是否翻转，
         定宽让结果行的换行在第一趟布局就定形（与 CalendarFlyout 同一教训）。 -->
    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="36" ShadowDepth="10" Direction="270"
                          Color="#000000" Opacity="0.62"/>

        <!-- 结果行：整行是命中区（点哪行启动哪行），选中态用强调色的软填充 + 左缘 2dip accent 竖条
             + 底缘 1px 发丝边（Aur* 选中行语义键：macOS 下是原 accent@0.92 的同值兜底，Aurora 下是
             低透明 accent 软填充，压在抓屏模糊之上不会把图标与名称糊成一片；强调色来自
             DynamicResource，换色/换主题/亮暗切换自动跟随——AurSelectionHairline 就是运行时 accent 画刷）。
             【左缘竖条与内容定位】BorderThickness 左缘 2px 会把内容往右推 2px，触发器里同步把左内边距
             14 → 12，选中与未选中的图标 x 起点逐像素一致（行间不跳）。
             【不用 Effect/不加动画】本面板是瞬态表面，但行模板会被虚拟化重排：Effect 会把它推进
             离屏滤镜管线（本项目对 Dock 的逐帧路径已裁定禁止），这里也无需引入第二套材质。 -->
        <Style x:Key="RowStyle" TargetType="Border">
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AurSelectionFill}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AurSelectionHairline}"/>
                    <Setter Property="BorderThickness" Value="2,0,0,1"/>
                    <Setter Property="Padding" Value="12,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 搜索框：无边框、大字号、底色透明（玻璃卡上不画"输入控件的白盒子"）。 -->
        <Style x:Key="SearchStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Shell" Margin="22,20,22,26">
        <Border x:Name="Card" Width="700" CornerRadius="20" BorderThickness="1" BorderBrush="#40FFFFFF"
                Background="{DynamicResource AurPopupFillSolid}" Effect="{StaticResource CardShadow}">
            <Grid>
                <Border x:Name="Scrim" CornerRadius="19" IsHitTestVisible="False" Background="Transparent"/>
                <Border x:Name="TintLayer" CornerRadius="19" IsHitTestVisible="False"
                        Background="{DynamicResource ThemeBackdropTint}"/>
                <Border x:Name="InnerGlow" CornerRadius="19" IsHitTestVisible="False"
                        Background="{DynamicResource AurInnerGlowBrush}"/>

                <StackPanel>
                    <!-- 搜索行：图标 + 输入框。键位提示放在结果区下方，避免与用户正在打的字抢位置。 -->
                    <Grid Margin="24,20,24,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="SearchGlyph" Grid.Column="0"
                              Data="{StaticResource SymbolSearch}" Width="20" Height="20" Stretch="Uniform"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"
                              Stroke="{DynamicResource ThemeTextPrimary}"
                              VerticalAlignment="Center" Margin="6,0,16,0" Opacity="0.85"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchStyle}"
                                 AutomationProperties.Name="启动器搜索框"
                                 TextChanged="Search_TextChanged"/>
                    </Grid>

                    <!-- 搜索区与结果区之间的发丝线：macOS Spotlight 输入区下有一条分隔线，
                         与底部提示行上方的分隔线（Results/StatusText 之后那条）同色同做法。 -->
                    <Border Height="1" Margin="22,0,22,8" Background="#1AFFFFFF"/>

                    <!-- 结果列表：行内是图标 + 名称 + 启动目标（真实路径，不是编的副标题）。
                         没有结果时整块隐藏，由下面的 StatusText 说明原因（建索引中 / 没有匹配 / 共 N 条）。 -->
                    <ItemsControl x:Name="Results" Margin="10,0,10,4"
                                  AutomationProperties.Name="启动器结果列表">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowStyle}" MouseLeftButtonUp="Row_MouseUp"
                                        ToolTip="{Binding LaunchPath}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Width="36" Height="36" Margin="0,0,14,0"
                                               Source="{Binding Icon}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <!-- 取不到图标的条目画一个空框而不是 ▣ 之类的假图标：
                                             名字与路径已经足够指认，字形占位会被误读成"这就是它的图标"。 -->
                                        <Border Grid.Column="0" Width="36" Height="36" Margin="0,0,14,0"
                                                BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="7"
                                                Visibility="{Binding IconMissing}"/>
                                        <!-- Big Sur 结果行：主标题 + 副标题（启动目标/类别），两行都省略而不是并排挤 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14.5"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Target}" FontSize="11.5" Opacity="0.55"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="StatusText" Margin="24,4,24,6" FontSize="12" Opacity="0.72"
                               TextTrimming="CharacterEllipsis"/>
                    <Border Height="1" Margin="22,4,22,8" Background="#1AFFFFFF"/>
                    <TextBlock x:Name="HintText" Margin="24,0,24,14" FontSize="11.5" Opacity="0.55"
                               Text="Enter 启动 · ↑ ↓ 选择 · Esc 关闭"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
