<Window x:Class="Beautiful.App.Launcher.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动台" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Background="#101014" Foreground="#FFFFFFFF"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" MouseWheel="Root_MouseWheel">
        <Image x:Name="WallpaperImage" Stretch="UniformToFill" Opacity="0.85"/>
        <Border Background="#B3000000"/>
        <Grid Margin="70,46,70,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 搜索条尺寸取自 MacDock 的 launchpad_search.h：480×40、圆角 20、水平居中 -->
            <Border x:Name="SearchField" Width="480" MaxWidth="720" Height="40" CornerRadius="20"
                    Background="#2EFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,10">
                <Grid>
                    <TextBlock x:Name="SearchPlaceholder" Text="搜索" FontSize="13" Opacity="0.55"
                               VerticalAlignment="Center" Margin="42,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="#FFFFFFFF" CaretBrush="#FFFFFFFF" FontSize="16"
                             VerticalContentAlignment="Center" Margin="42,0,12,0"
                             TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
                    <Path Data="{DynamicResource SymbolSearch}" Style="{StaticResource MacSymbol}"
                          Width="14" Height="14" HorizontalAlignment="Left" Margin="14,0,0,0"
                          Stroke="#AAFFFFFF"/>
                </Grid>
            </Border>

            <!-- 文件夹 chip 条：没有文件夹时整行不占位（MacDock 同样是"有夹才出现"，不推开网格） -->
            <StackPanel x:Name="FolderStrip" Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,0,0,10" Visibility="Collapsed"/>

            <ListBox x:Name="Tiles" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     KeyDown="Tiles_KeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 列/行由 LaunchpadGridRules 按窗口尺寸算出（MacDock 同规则）：
                             宽屏多列、窄屏缩图标，一页容量随之变化 -->
                        <UniformGrid Columns="{Binding TileColumns, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                     Rows="{Binding TileRows, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Focusable" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="4">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalContentAlignment="Center" Click="Tile_Click" Tag="{Binding}"
                                MouseEnter="Tile_MouseEnter" MouseLeave="Tile_MouseLeave">
                            <StackPanel Width="112" Margin="2,4">
                                <Image Source="{Binding Icon}" Stretch="Uniform"
                                       Width="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       Height="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Image.RenderTransform>
                                </Image>
                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,6,0,0"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="104" Foreground="#FFFFFFFF"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center"/>
                <TextBlock x:Name="Status" FontSize="12" Opacity="0.7" Margin="18,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 文件夹覆盖层（Phase 5 收尾）：点文件夹图标打开，点空白关闭 -->
        <Grid x:Name="FolderOverlay" Visibility="Collapsed" Background="#66000000"
              MouseLeftButtonDown="FolderOverlay_Click">
            <Border Width="600" MaxHeight="430" CornerRadius="18" Background="#EE1B1B1F"
                    BorderBrush="#22FFFFFF" BorderThickness="1" Padding="22,18"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock x:Name="FolderTitle" Text="文件夹" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="#FFFFFFFF"/>
                        <Button Content="完成" HorizontalAlignment="Right" Padding="10,3"
                                Background="#22FFFFFF" BorderThickness="0" Foreground="#FFFFFFFF"
                                Click="FolderClose_Click"/>
                    </Grid>
                    <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FolderItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                                            Click="FolderMember_Click" Tag="{Binding}"
                                            MouseRightButtonUp="FolderMember_RightUp"
                                            ToolTip="右键：移出文件夹">
                                        <StackPanel Width="96" Margin="4">
                                            <Image Source="{Binding Icon}" Width="62" Height="62" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="88"
                                                       Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
