<UserControl x:Class="Beautiful.App.Controls.ControlCenterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False"
             AutomationProperties.Name="控制中心面板"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             FontFamily="{DynamicResource ThemeFontFamily}"
             Foreground="{DynamicResource ThemeTextPrimary}">

    <!-- 控制中心（v3 T7）：顶栏右端图标唤出的快速设置面板。
         【材质与托盘菜单同源，不另发明一套】宿主是 FluentPopupHost（分层窗口 + 显示前抓屏模糊），
         这里的叠放顺序与 FluentMenu 完全一致：Card.Background（抓屏模糊或实心卡底 CardFillSolid）
         → Scrim（有模糊时压半透明深色 CardFillBlur 保文字对比度）→ TintLayer（ThemeBackdropTint）
         → InnerGlow（顶部内高光）。Shell.Margin 给自绘投影留位——分层窗口上"没画到"就是看穿到桌面的洞，
         两条分支都必须把整张卡铺满。渲染恒为深色玻璃（与托盘菜单/日历浮层同一观感），不随主题明暗。
         【Card 用定宽而不是 MinWidth】宿主按 Measure(inf,inf) 同步量尺寸来决定弹层大小与是否翻转，
         定宽让星号列/换行文本在第一趟布局就定形（同 CalendarFlyout 用固定单元格的同一教训）。 -->
    <UserControl.Resources>
        <!-- alpha.22：macOS 无把手粗胶囊滑条（填充段即把手，点哪跳哪、拖填充边缘走）。
             自足样式：填充白胶囊在亮/暗两主题下都与 MacControlFillHover 轨道有足够对比；
             Thumb 保留（WPF Track 必需）但视觉透明，只占填充边缘 14px 的可拖区。 -->
        <Style x:Key="CcMacThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CcMacSliderDecrease" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="26" Background="Transparent">
                            <Border Height="20" CornerRadius="10" VerticalAlignment="Center"
                                    Background="#F0FFFFFF"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CcMacSliderIncrease" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="26" Background="Transparent">
                            <Border Height="20" CornerRadius="10" VerticalAlignment="Center"
                                    Background="{DynamicResource MacControlFillHover}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CcMacSlider" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="26" Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Style="{StaticResource CcMacSliderDecrease}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="20" Style="{StaticResource CcMacThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Style="{StaticResource CcMacSliderIncrease}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 控制中心最标志性的一块：亮度 / 音量两根并排**竖向**粗胶囊滑杆。
             横向滑杆一眼就是 Windows 快速设置；这里把轨道竖起来，填充段从底部往上长，
             Thumb 保留但视觉透明（只占填充边缘可拖区），与横向那套同一套配色语义。 -->
        <Style x:Key="CcMacSliderVDecrease" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Width="26" Background="Transparent">
                            <Border Width="20" CornerRadius="10" HorizontalAlignment="Center"
                                    Background="#F0FFFFFF"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CcMacSliderVIncrease" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!-- 轨道底色由 Slider 模板里那一整根 Border 统一画；这里若再画一段圆角，
                             就会和填充段拼成「两颗断开的胶囊」（真机截图实锤）。 -->
                        <Grid Width="26" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CcMacSliderVertical" TargetType="Slider">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="118"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Width="26" Background="Transparent">
                            <!-- 一整根连续的灰色轨道：填充段与未填充段不再各画一颗圆角胶囊，
                                 真机截图里那道断缝就是两段各自圆角造成的。macOS 是一根到底的胶囊。 -->
                            <Border Width="20" CornerRadius="10" HorizontalAlignment="Center"
                                    Background="{DynamicResource MacControlFillHover}"/>
                            <Track x:Name="PART_Track" Orientation="Vertical" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Style="{StaticResource CcMacSliderVDecrease}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="26" Height="4" Style="{StaticResource CcMacThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Style="{StaticResource CcMacSliderVIncrease}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="CardFillSolid" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F82C2C2F" Offset="0"/>
            <GradientStop Color="#FB1F1F23" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardFillBlur" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A232327" Offset="0"/>
            <GradientStop Color="#9919191C" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="32" ShadowDepth="9" Direction="270"
                          Color="#000000" Opacity="0.6"/>

        <!-- 分段按钮（主题 / 任务栏策略三选一）：WPF 里"同组互斥"只有 RadioButton 有（ToggleButton 没有
             GroupName），所以用 RadioButton + 完全自绘模板（看不到圆点，只有 pill 底色），
             代码侧只需在投影里把当前 Id 那一项勾上。 -->
        <Style x:Key="CcSegmentStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#00FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关砖块（放大 / 倒影 / 媒体胶囊）：macOS 控制中心式圆角块，
             打开时压一层强调色底 + 左上强调色环，下面一行"开/关"文字给出可读状态（不只靠颜色，
             置灰时同一行位置换成不可用原因，界面不需要第二套说明文案）。 -->
        <Style x:Key="CcTileStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="66"/>
            <!-- 垂直间距不能是 0：UniformGrid 两行砖块上下会直接贴死（真机截图实锤），macOS 控制中心
                 砖块之间有肉眼可见的缝。左右 3 是原本就有的列缝，上下给 4，末行再由 TileHost 的
                 Margin 收掉。 -->
            <Setter Property="Margin" Value="3,4,3,0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="9,7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="Title" Grid.Row="0" Text="{TemplateBinding Content}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <!-- 状态行：可用时是"开/关"，置灰时样式把 ToolTip 里的原因抄到这一行
                                     （所以这里给截断省略号：砖块只有 ~90 DIP 宽，长文案宁可省略 + ToolTip 全文，
                                     也不要撑破卡片或把"开/关"挤没） -->
                                <TextBlock x:Name="State" Grid.Row="1" FontSize="10.5" Opacity="0.72"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <Border x:Name="Ring" Grid.Row="0" Width="9" Height="9" CornerRadius="4.5"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="{DynamicResource ThemeAccent}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3FFFFFFF"/>
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="State" Property="Text" Value="开"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="State" Property="Text" Value="关"/>
                            </Trigger>
                            <!-- 置灰：原因直接写在状态行（截断由 ToolTip 兜住），并压暗整块 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter TargetName="State" Property="Text" Value="{Binding Path=ToolTip, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分组容器（Big Sur 控制中心里"显示/声音"那种整块瓦片）：圆角 12 + 1px 发丝边 + 半透明底。 -->
        <Style x:Key="CcGroupStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 动作瓦片（蓝牙 / 隔空投送 / 专注）：与开关瓦片同尺寸同观感，但语义是"打开系统页"或"不可用"。
             副标题走 Tag，置灰时仍显示原因——不做"看起来能开、其实没反应"的假开关。 -->
        <Style x:Key="CcActionTileStyle" TargetType="Button">
            <Setter Property="Height" Value="66"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="9,7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{TemplateBinding Content}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Grid.Row="1" Text="{TemplateBinding Tag}" FontSize="10.5" Opacity="0.72"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部动作按钮（打开设置… / 重载 Dock）：与顶栏 BarButton 同一观感（透明底 + 悬停强调） -->
        <Style x:Key="CcFooterStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemePanelBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Shell" Margin="20,18,20,24">
        <!-- macOS 控制中心的大圆角玻璃卡：20DIP 圆角 + 几乎看不见的发丝边；原来的 12DIP +
             #2AFFFFFF 描边在深色壁纸上是明显一圈白框，读起来是 Windows 面板而不是 mac 的下拉卡。 -->
        <Border x:Name="Card" Width="330" CornerRadius="20" BorderThickness="1" BorderBrush="#16FFFFFF"
                Background="{StaticResource CardFillSolid}" Effect="{StaticResource CardShadow}">
            <Grid>
                <Border x:Name="Scrim" CornerRadius="19" IsHitTestVisible="False" Background="Transparent"/>
                <Border x:Name="TintLayer" CornerRadius="19" IsHitTestVisible="False"
                        Background="{DynamicResource ThemeBackdropTint}"/>
                <Border x:Name="InnerGlow" CornerRadius="19" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#05FFFFFF" Offset="0.35"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Margin="16,14,16,12">
                    <!-- macOS 控制中心没有"控制中心"这个标题：面板顶部直接是连接卡。
                         左侧标题收起，右侧当前主题保留（打开时快照，切主题后由 RebuildAll 刷新）。 -->
                    <Grid Margin="2,0,2,9">
                        <TextBlock Text="控制中心" FontSize="13.5" FontWeight="SemiBold" Visibility="Collapsed"/>
                        <TextBlock x:Name="ThemeLabel" HorizontalAlignment="Right" FontSize="11.5" Opacity="0.72"/>
                    </Grid>

                    <!-- ============ 连接组（Big Sur 的 2×2 瓦片） ============
                         Wi-Fi 是真开关（WlanSetInterface）；蓝牙要管理员权限、隔空投送在 Windows 上没有对应物，
                         所以后两者**不做假开关**：蓝牙点开系统蓝牙页，隔空投送置灰并写明原因。 -->
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <ToggleButton x:Name="WifiTile" Content="Wi-Fi" Style="{StaticResource CcTileStyle}"
                                      Margin="0,0,4,4" Checked="WifiTile_Changed" Unchecked="WifiTile_Changed"
                                      AutomationProperties.Name="控制中心 Wi-Fi 开关"/>
                        <Button x:Name="BluetoothButton" Content="蓝牙" Tag="打开系统蓝牙页"
                                Style="{StaticResource CcActionTileStyle}" Margin="4,0,0,4"
                                Click="Bluetooth_Click"
                                AutomationProperties.Name="控制中心 打开蓝牙设置"/>
                        <Button x:Name="AirDropButton" Content="隔空投送" Tag="Windows 无对应能力"
                                Style="{StaticResource CcActionTileStyle}" Margin="0,4,4,0"
                                IsEnabled="False"
                                ToolTip="Windows 没有与隔空投送对等的系统能力（就近共享需应用自行实现）"
                                AutomationProperties.Name="控制中心 隔空投送（不可用）"/>
                        <Button x:Name="FocusButton" Content="专注模式" Tag="打开系统专注设置"
                                Style="{StaticResource CcActionTileStyle}" Margin="4,4,0,0"
                                Click="Focus_Click"
                                AutomationProperties.Name="控制中心 打开专注模式设置"/>
                    </UniformGrid>
                    <TextBlock x:Name="AccountLine" Text="未登录" FontSize="10.5" Opacity="0.62"
                               Margin="4,0,4,8" TextTrimming="CharacterEllipsis"
                               ToolTip="账户与可移动磁盘数量"/>
                    <TextBlock x:Name="WifiReason" FontSize="10.5" Opacity="0.62" TextWrapping="Wrap"
                               Margin="4,0,4,6" Visibility="Collapsed"/>

                    <!-- ============ 系统状态行（P4-T9 / P4-T10） ============
                         电量 / 网络 / 蓝牙 / 输入法：四项一次采样、同一行显示，避免"电量新、网络旧"。
                         全部只读系统接口，读不到就显示占位，不做假开关。 -->
                    <Border Style="{StaticResource CcGroupStyle}" Margin="0,0,0,8">
                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock x:Name="BatteryGlyph" Text="&#xE83F;" FontSize="14"
                                           HorizontalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource ThemeTextPrimary}"/>
                                <TextBlock x:Name="BatteryValue" Text="--" FontSize="10.5" Opacity="0.72"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="&#xE774;" FontSize="14" HorizontalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource ThemeTextPrimary}"/>
                                <TextBlock x:Name="NetworkValue" Text="离线" FontSize="10.5" Opacity="0.72"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="66"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="&#xE702;" FontSize="14" HorizontalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource ThemeTextPrimary}"/>
                                <TextBlock x:Name="BluetoothValue" Text="不可用" FontSize="10.5" Opacity="0.72"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="InputValue" Text="EN" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource ThemeTextPrimary}"/>
                                <TextBlock Text="输入法" FontSize="10.5" Opacity="0.72"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- ============ 亮度 / 音量：macOS 控制中心两根并排的竖向粗胶囊滑杆 ============
                         真机对照里横滑杆是最刺眼的 Windows 味；这里把轨道竖起来，填充段从底部往上长。
                         所有 x:Name 与事件处理器保持原样，code-behind 的真实音量/亮度读写不受影响。 -->
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Border Style="{StaticResource CcGroupStyle}" Margin="0,0,4,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Slider x:Name="BrightnessSlider" Grid.Row="0" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Minimum="0" Maximum="100"
                                        Style="{StaticResource CcMacSliderVertical}"
                                        IsMoveToPointEnabled="True"
                                        TickFrequency="1" SmallChange="1" LargeChange="5"
                                        ValueChanged="Brightness_ValueChanged"
                                        AutomationProperties.Name="屏幕亮度"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="&#xE706;" FontSize="14" Margin="0,0,6,0"
                                               VerticalAlignment="Center" Opacity="0.85"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <TextBlock x:Name="BrightnessText" MinWidth="42"
                                               FontSize="11.5" Opacity="0.85" TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CcGroupStyle}" Margin="4,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Slider x:Name="VolumeSlider" Grid.Row="0" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Minimum="0" Maximum="100"
                                        Style="{StaticResource CcMacSliderVertical}"
                                        IsMoveToPointEnabled="True"
                                        TickFrequency="1" SmallChange="1" LargeChange="5"
                                        ValueChanged="Volume_ValueChanged"
                                        PreviewMouseLeftButtonDown="Volume_DragBegin"
                                        PreviewMouseLeftButtonUp="Volume_DragEnd"
                                        LostMouseCapture="Volume_DragEnd"
                                        AutomationProperties.Name="系统音量"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,8,0,0">
                                    <Button x:Name="MuteButton" Width="26" Height="24" Margin="0,0,6,0"
                                            Content="&#xE767;" FontSize="13" Padding="0"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Foreground="{DynamicResource ThemeTextPrimary}"
                                            Style="{StaticResource CcFooterStyle}" Click="Mute_Click"
                                            AutomationProperties.Name="静音开关"/>
                                    <TextBlock x:Name="VolumeText" MinWidth="42"
                                               FontSize="11.5" Opacity="0.85" TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="BrightnessReason" FontSize="10.5" Opacity="0.62" TextWrapping="Wrap"
                               Margin="4,0,4,6" Visibility="Collapsed"/>
                    <TextBlock x:Name="VolumeReason" FontSize="10.5" Opacity="0.62" TextWrapping="Wrap"
                               Margin="4,0,4,6" Visibility="Collapsed"/>

                    <!-- ============ 逐应用音量（Phase 7-T5） ============
                         Core Audio 会话级音量：每个应用一条会话，改它不影响系统总音量。
                         会话列表是打开面板时的快照，右上"刷新"重新枚举（不订阅会话通知：瞬态面板不值当）。 -->
                    <Border Style="{StaticResource CcGroupStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="逐应用音量" FontSize="11" Opacity="0.62" VerticalAlignment="Center"/>
                                <Button x:Name="MixerRefreshButton" Content="刷新" HorizontalAlignment="Right"
                                        Height="20" Padding="8,0" FontSize="10.5"
                                        Style="{StaticResource CcFooterStyle}" Click="MixerRefresh_Click"
                                        AutomationProperties.Name="刷新逐应用音量列表"/>
                            </Grid>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="MixerList"/>
                            </ScrollViewer>
                            <TextBlock x:Name="MixerReason" FontSize="10.5" Opacity="0.62" TextWrapping="Wrap"
                                       Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- ============ 外观（主题三选一） ============ -->
                    <TextBlock Text="外观" FontSize="11" Opacity="0.62" Margin="4,2,0,4"/>
                    <!-- 宽度锁 210：主题只剩 macOS 一项时，UniformGrid 的单个子元素会撑满整行，
                         看起来像"一个巨大的按钮"；限宽后单段仍是 1/3 宽的小胶囊（与三选一时期一致）。 -->
                    <UniformGrid x:Name="ThemeHost" Columns="3" Width="210" HorizontalAlignment="Left"
                                 Margin="0,0,0,8"/>

                    <!-- ============ Dock 开关砖块（放大 / 倒影 / 媒体胶囊） ============ -->
                    <UniformGrid x:Name="TileHost" Columns="2" Margin="0,0,0,6"/>

                    <!-- ============ 系统任务栏 ============ -->
                    <TextBlock Text="系统任务栏" FontSize="11" Opacity="0.62" Margin="4,2,0,4"/>
                    <UniformGrid x:Name="PolicyHost" Columns="3" Margin="0,0,0,2"/>
                    <TextBlock x:Name="PolicyHintText" FontSize="10.5" Opacity="0.62" TextWrapping="Wrap"
                               Margin="4,2,4,8"/>

                    <Separator Margin="2,2,2,7" Background="#1AFFFFFF"/>

                    <UniformGrid Columns="2">
                        <Button x:Name="SettingsButton" Content="打开设置…" Style="{StaticResource CcFooterStyle}"
                                Margin="0,0,4,0" Click="Settings_Click" AutomationProperties.Name="控制中心 打开设置"/>
                        <Button x:Name="ReloadButton" Content="重载 Dock" Style="{StaticResource CcFooterStyle}"
                                Margin="4,0,0,0" Click="Reload_Click" AutomationProperties.Name="控制中心 重载 Dock"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
