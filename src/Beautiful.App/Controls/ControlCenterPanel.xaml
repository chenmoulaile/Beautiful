<UserControl x:Class="Beautiful.App.Controls.ControlCenterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False"
             AutomationProperties.Name="控制中心面板"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             FontFamily="{DynamicResource ThemeFontFamily}"
             Foreground="{DynamicResource ThemeTextPrimary}">

    <!-- 控制中心（v3 T7）：顶栏右端图标唤出的快速设置面板。
         【材质与托盘菜单同源，不另发明一套】宿主是 FluentPopupHost（分层窗口 + 显示前抓屏模糊），
         这里的叠放顺序与 FluentMenu 完全一致：Card.Background（抓屏模糊或实心卡底 CardFillSolid）
         → Scrim（有模糊时压半透明深色 CardFillBlur 保文字对比度）→ TintLayer（ThemeBackdropTint）
         → InnerGlow（顶部内高光）。Shell.Margin 给自绘投影留位——分层窗口上"没画到"就是看穿到桌面的洞，
         两条分支都必须把整张卡铺满。渲染恒为深色玻璃（与托盘菜单/日历浮层同一观感），不随主题明暗。
         【Card 用定宽而不是 MinWidth】宿主按 Measure(inf,inf) 同步量尺寸来决定弹层大小与是否翻转，
         定宽让星号列/换行文本在第一趟布局就定形（同 CalendarFlyout 用固定单元格的同一教训）。 -->
    <UserControl.Resources>
        <LinearGradientBrush x:Key="CardFillSolid" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F82C2C2F" Offset="0"/>
            <GradientStop Color="#FB1F1F23" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardFillBlur" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A232327" Offset="0"/>
            <GradientStop Color="#9919191C" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="32" ShadowDepth="9" Direction="270"
                          Color="#000000" Opacity="0.6"/>

        <!-- 分段按钮（主题 / 任务栏策略三选一）：WPF 里"同组互斥"只有 RadioButton 有（ToggleButton 没有
             GroupName），所以用 RadioButton + 完全自绘模板（看不到圆点，只有 pill 底色），
             代码侧只需在投影里把当前 Id 那一项勾上。 -->
        <Style x:Key="CcSegmentStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#00FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关砖块（放大 / 倒影 / 媒体胶囊）：macOS 控制中心式圆角块，
             打开时压一层强调色底 + 左上强调色环，下面一行"开/关"文字给出可读状态（不只靠颜色，
             置灰时同一行位置换成不可用原因，界面不需要第二套说明文案）。 -->
        <Style x:Key="CcTileStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="66"/>
            <Setter Property="Margin" Value="3,0,3,0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="9,7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="Title" Grid.Row="0" Text="{TemplateBinding Content}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <!-- 状态行：可用时是"开/关"，置灰时样式把 ToolTip 里的原因抄到这一行
                                     （所以这里给截断省略号：砖块只有 ~90 DIP 宽，长文案宁可省略 + ToolTip 全文，
                                     也不要撑破卡片或把"开/关"挤没） -->
                                <TextBlock x:Name="State" Grid.Row="1" FontSize="10.5" Opacity="0.72"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <Border x:Name="Ring" Grid.Row="0" Width="9" Height="9" CornerRadius="4.5"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="{DynamicResource ThemeAccent}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3FFFFFFF"/>
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="State" Property="Text" Value="开"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="State" Property="Text" Value="关"/>
                            </Trigger>
                            <!-- 置灰：原因直接写在状态行（截断由 ToolTip 兜住），并压暗整块 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter TargetName="State" Property="Text" Value="{Binding Path=ToolTip, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部动作按钮（打开设置… / 重载 Dock）：与顶栏 BarButton 同一观感（透明底 + 悬停强调） -->
        <Style x:Key="CcFooterStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemePanelBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Shell" Margin="20,18,20,24">
        <Border x:Name="Card" Width="312" CornerRadius="12" BorderThickness="1" BorderBrush="#2AFFFFFF"
                Background="{StaticResource CardFillSolid}" Effect="{StaticResource CardShadow}">
            <Grid>
                <Border x:Name="Scrim" CornerRadius="11" IsHitTestVisible="False" Background="Transparent"/>
                <Border x:Name="TintLayer" CornerRadius="11" IsHitTestVisible="False"
                        Background="{DynamicResource ThemeBackdropTint}"/>
                <Border x:Name="InnerGlow" CornerRadius="11" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#05FFFFFF" Offset="0.35"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Margin="13,11,13,9">
                    <!-- 标题行：左"控制中心"，右"当前主题：xxx"（打开时快照，切主题后由 RebuildAll 刷新） -->
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="控制中心" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ThemeLabel" HorizontalAlignment="Right" FontSize="11.5" Opacity="0.72"/>
                    </Grid>

                    <TextBlock Text="主题" FontSize="11" Opacity="0.62" Margin="1,0,0,3"/>
                    <UniformGrid x:Name="ThemeHost" Columns="3" Margin="0,0,0,8"/>

                    <TextBlock Text="系统任务栏" FontSize="11" Opacity="0.62" Margin="1,0,0,3"/>
                    <UniformGrid x:Name="PolicyHost" Columns="3" Margin="0,0,0,4"/>
                    <TextBlock x:Name="PolicyHintText" FontSize="10.5" Opacity="0.62" TextWrapping="Wrap"
                               Margin="1,0,1,8"/>

                    <UniformGrid x:Name="TileHost" Columns="3" Margin="0,0,0,2"/>

                    <!-- 音量行：图标按钮（静音旗标）+ 滑杆 + 读数。不可用时整行置灰，
                         下面一行 VolumeReason 给出中文原因（绝不显示一个编出来的百分比）。 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MuteButton" Grid.Column="0" Width="30" Height="26" Margin="0,0,7,0"
                                Content="&#xE767;" FontSize="13" Padding="0"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Foreground="{DynamicResource ThemeTextPrimary}"
                                Style="{StaticResource CcFooterStyle}" Click="Mute_Click"
                                AutomationProperties.Name="静音开关"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                TickFrequency="1" SmallChange="1" LargeChange="5"
                                ValueChanged="Volume_ValueChanged"
                                PreviewMouseLeftButtonDown="Volume_DragBegin"
                                PreviewMouseLeftButtonUp="Volume_DragEnd"
                                LostMouseCapture="Volume_DragEnd"
                                AutomationProperties.Name="系统音量"/>
                        <TextBlock x:Name="VolumeText" Grid.Column="2" MinWidth="46" Margin="8,0,0,0"
                                   FontSize="11.5" Opacity="0.85" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="VolumeReason" FontSize="10.5" Opacity="0.62" TextWrapping="Wrap"
                               Margin="1,3,1,0" Visibility="Collapsed"/>

                    <Separator Margin="1,9,1,7" Background="#1AFFFFFF"/>

                    <UniformGrid Columns="2">
                        <Button x:Name="SettingsButton" Content="打开设置…" Style="{StaticResource CcFooterStyle}"
                                Margin="0,0,4,0" Click="Settings_Click" AutomationProperties.Name="控制中心 打开设置"/>
                        <Button x:Name="ReloadButton" Content="重载 Dock" Style="{StaticResource CcFooterStyle}"
                                Margin="4,0,0,0" Click="Reload_Click" AutomationProperties.Name="控制中心 重载 Dock"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
