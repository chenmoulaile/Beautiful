<Window x:Class="Beautiful.App.Controls.VolumeOsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音量" Width="244" Height="88"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual" IsHitTestVisible="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Phase 4-T7：macOS 音量 HUD。
         这是唯一允许使用 AllowsTransparency 的常驻类窗口：内容只有图标与色块，没有文字正文，
         不存在分层窗口关掉 ClearType 的代价（设置页/Finder 那条约束在这里不适用）。
         窗口不抢焦点（ShowActivated=False + WS_EX_NOACTIVATE）、不接收点击（WS_EX_TRANSPARENT）。 -->
    <!-- macOS Big Sur 的 HUD 是一块横向胶囊：喇叭图标在左、16 格音量条在右，
         没有数字、没有标题。此前做成了"图标在上、条在下"的竖版，观感更像 Windows 的浮层。 -->
    <Border CornerRadius="20" Background="#E6151517"
            BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="16,0">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="GlyphText" Text="&#xE767;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="36" Foreground="#FFFFFFFF"
                       VerticalAlignment="Center" Width="40" TextAlignment="Center"/>
            <StackPanel x:Name="SegmentHost" Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="14,0,0,0"/>
            <TextBlock x:Name="LevelText" Text="" FontSize="11" Foreground="#B3FFFFFF"
                       HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
