<Window x:Class="Beautiful.App.Controls.VolumeOsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音量" Width="200" Height="136"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual" IsHitTestVisible="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Phase 4-T7：macOS 音量 HUD。
         这是唯一允许使用 AllowsTransparency 的常驻类窗口：内容只有图标与色块，没有文字正文，
         不存在分层窗口关掉 ClearType 的代价（设置页/Finder 那条约束在这里不适用）。
         窗口不抢焦点（ShowActivated=False + WS_EX_NOACTIVATE）、不接收点击（WS_EX_TRANSPARENT）。 -->
    <Border CornerRadius="22" Background="#E8181818"
            BorderBrush="#28FFFFFF" BorderThickness="1" Padding="18,16">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="GlyphText" Text="&#xE767;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="34" Foreground="#FFFFFFFF"
                       HorizontalAlignment="Center"/>
            <StackPanel x:Name="SegmentHost" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,16,0,2"/>
            <TextBlock x:Name="LevelText" Text="" FontSize="11" Foreground="#B3FFFFFF"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
