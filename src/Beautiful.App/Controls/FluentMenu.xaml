<UserControl x:Class="Beautiful.App.Controls.FluentMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI">

    <!-- 自绘菜单，视觉对标 macOS；无第三方代码。
         【单一形态（v3 T2/T3）】宿主 FluentPopupHost 恒为分层窗口 → 逐像素 alpha 成立，于是这里只有一种画法：
         外圈 Shell.Margin 为自绘投影留位，Card 自绘 10px 圆角 + 1px 亮边 + DropShadow。
         v2 的"背板形态（卡铺满窗口、圆角交 DWM 裁切、不画描边）"整枝删除：那套形态在真机上画不出背板，
         只会让卡片带着未合成的客户端像素出现成黑矩形。
         四层叠放顺序 = 材质顺序：Card.Background（抓屏模糊，或实心卡底 CardFillSolid）→ Scrim
         （有模糊时压一层 CardFillBlur 半透明深色保文字对比度）→ TintLayer（ThemeBackdropTint，
         DynamicResource 随主题变色）→ InnerGlow（顶部内高光）。
         行模板：勾选列 | 图标列 | 标签 | ▸ 箭头列，悬停 60ms 圆角高亮滑入（缩放+淡入）。
         渲染语言不随主题明暗：菜单恒为深色玻璃卡 + 近白文字（主题 token 取强调色/字体 + ThemeBackdropTint）。 -->
    <UserControl.Resources>
        <!-- 卡底降级形态：抓屏不可用时自铺**实心**渐变（分层窗口上"没画到"= 看穿到桌面，绝不允许）；
             有模糊时它退位给 Card.Background，改由下面的 CardFillBlur 作半透明遮罩层。 -->
        <LinearGradientBrush x:Key="CardFillSolid" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F82C2C2F" Offset="0"/>
            <GradientStop Color="#FB1F1F23" Offset="1"/>
        </LinearGradientBrush>
        <!-- 模糊背板之上的遮罩：半透明深色渐变，负责文字对比度（不是"透出系统模糊"，那是 v2 的说法） -->
        <LinearGradientBrush x:Key="CardFillBlur" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A232327" Offset="0"/>
            <GradientStop Color="#9919191C" Offset="1"/>
        </LinearGradientBrush>
        <!-- 自绘投影（分层窗口的阴影只能画在自己的表面里，投影留位由 Shell.Margin 提供） -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="32" ShadowDepth="9" Direction="270"
                          Color="#000000" Opacity="0.6"/>
    </UserControl.Resources>
    <Grid x:Name="Shell" Margin="20,18,20,24">
        <Border x:Name="Card" CornerRadius="10" BorderThickness="1" BorderBrush="#2AFFFFFF" MinWidth="230"
                Background="{StaticResource CardFillSolid}" Effect="{StaticResource CardShadow}">
            <Grid>
                <!-- 模糊背板之上的深色遮罩：仅在拿到抓屏模糊时铺 CardFillBlur（代码侧切换），
                     实心底形态下保持透明——叠在实心卡上只会让菜单更闷。 -->
                <Border x:Name="Scrim" CornerRadius="9" IsHitTestVisible="False" Background="Transparent"/>
                <!-- 主题 tint 覆盖层：压在卡底/遮罩之上、内容与内高光之下，换主题即随 DynamicResource 变色。 -->
                <Border x:Name="TintLayer" CornerRadius="9" IsHitTestVisible="False"
                        Background="{DynamicResource ThemeBackdropTint}"/>
                <!-- 顶部内高光：macOS 玻璃感的"light top edge" -->
                <Border x:Name="InnerGlow" CornerRadius="9" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#05FFFFFF" Offset="0.35"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <ListBox x:Name="Rows" Margin="5,7,5,7" Focusable="False" Background="Transparent"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False">
                    <ListBox.ItemContainerStyle>
                        <!-- 容器纯平铺（无选中/悬停 chrome，悬停高亮在行模板内自绘）；
                             HorizontalContentAlignment=Stretch 让行贯穿卡宽（单趟布局即定形，
                             ItemsControl 的 ContentPresenter 对齐为只读附加属性，无法走此路） -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border x:Name="Row" Height="31" Margin="5,1.5" CornerRadius="7"
                                        Background="Transparent"
                                        MouseEnter="Row_MouseEnter" MouseLeave="Row_MouseLeave"
                                        MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                    <Grid>
                                        <Border x:Name="Glow" CornerRadius="7" Background="#2EFFFFFF"
                                                Opacity="0" IsHitTestVisible="False">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                            </Border.RenderTransform>
                                            <Border.RenderTransformOrigin>
                                                <Point X="0.5" Y="0.5"/>
                                            </Border.RenderTransformOrigin>
                                        </Border>
                                        <Grid Margin="10,0,11,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="17"/><!-- 勾选列 -->
                                                <ColumnDefinition Width="26"/><!-- 图标列 -->
                                                <ColumnDefinition Width="*"/>   <!-- 标签 -->
                                                <ColumnDefinition Width="18"/><!-- ▸ 箭头列 -->
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Check" Grid.Column="0" Text="&#x2713;"
                                                       FontSize="12.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource ThemeAccent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                            <TextBlock x:Name="GlyphText" Grid.Column="1" Text="{Binding Glyph}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="#D6FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="IconImage" Grid.Column="1" Source="{Binding Icon}"
                                                   Width="16" Height="16" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                            <TextBlock x:Name="LabelText" Grid.Column="2" Text="{Binding Label}"
                                                       ToolTip="{Binding ToolTip}"
                                                       FontSize="13.5" Foreground="{DynamicResource ThemeTextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="9" Foreground="#8CFFFFFF"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border x:Name="Sep" Height="1" Margin="13,7" Background="#1AFFFFFF"
                                        Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                            <!-- 高亮单一来源＝容器 IsSelected（评审 Important#3）：鼠标悬停经 Row_MouseEnter
                                 把选中项同步为该 Item，键盘 ↑↓/Home/End/Type-ahead 改 SelectedIndex —— 两者走
                                 同一条 Enter/ExitActions，观感完全一致（60ms 淡入 + 0.92→1 缩放滑入）。
                                 IsSelected 用 RelativeSource 取外层 ListBoxItem 容器（DataTemplate 内可达祖先）。 -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Sep" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- 位图图标（窗口菜单真实图标）：有图时隐藏字形、显示 Image -->
                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                    <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="IconImage" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- 置灰（控制器裁定：无对应系统能力的 macOS 风格条目）：淡文字、不可交互 -->
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter TargetName="LabelText" Property="Foreground" Value="#54FFFFFF"/>
                                    <Setter TargetName="GlyphText" Property="Foreground" Value="#3CFFFFFF"/>
                                    <Setter TargetName="IconImage" Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.06">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1" Duration="0:0:0.09">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1" Duration="0:0:0.09">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.09"/>
                                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.92" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="0.92" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
