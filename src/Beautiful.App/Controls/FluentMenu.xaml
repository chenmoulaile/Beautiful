<UserControl x:Class="Beautiful.App.Controls.FluentMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI">

    <!-- 自绘菜单，视觉对标 macOS；无第三方代码。
         结构：外圈 Margin 为投影留位；Card=10px 圆角深色半透明卡（顶部亮渐变+1px 发丝描边）；
         行模板：勾选列 | 图标列 | 标签 | ▸ 箭头列，悬停 60ms 圆角高亮滑入（缩放+淡入）。
         渲染语言不随主题明暗：菜单恒为深色毛玻璃卡 + 近白文字（主题 token 仅取强调色/字体）。 -->
    <Grid Margin="20,18,20,24">
        <Border x:Name="Card" CornerRadius="10" BorderThickness="1" BorderBrush="#2AFFFFFF" MinWidth="230">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F82C2C2F" Offset="0"/>
                    <GradientStop Color="#FB1F1F23" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="9" Direction="270"
                                  Color="#000000" Opacity="0.6"/>
            </Border.Effect>
            <Grid>
                <!-- 顶部内高光：macOS 玻璃感的"light top edge" -->
                <Border CornerRadius="9" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0DFFFFFF" Offset="0"/>
                            <GradientStop Color="#03FFFFFF" Offset="0.35"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <ItemsControl x:Name="Rows" Margin="5,7,5,7" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- MinWidth=宿主列宽：行高亮/分隔线贯穿全宽（ContentPresenter.HorizontalContentAlignment
                                 为只读附加属性，无法经 ItemContainerStyle 设置，改用此惯用法） -->
                            <Grid MinWidth="{Binding ActualWidth, ElementName=Rows}">
                                <Border x:Name="Row" Height="31" Margin="5,1.5" CornerRadius="7"
                                        Background="Transparent"
                                        MouseEnter="Row_MouseEnter" MouseLeave="Row_MouseLeave"
                                        MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                    <Grid>
                                        <Border x:Name="Glow" CornerRadius="7" Background="#2EFFFFFF"
                                                Opacity="0" IsHitTestVisible="False">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                            </Border.RenderTransform>
                                            <Border.RenderTransformOrigin>
                                                <Point X="0.5" Y="0.5"/>
                                            </Border.RenderTransformOrigin>
                                        </Border>
                                        <Grid Margin="10,0,11,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="17"/><!-- 勾选列 -->
                                                <ColumnDefinition Width="26"/><!-- 图标列 -->
                                                <ColumnDefinition Width="*"/>   <!-- 标签 -->
                                                <ColumnDefinition Width="18"/><!-- ▸ 箭头列 -->
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Check" Grid.Column="0" Text="&#x2713;"
                                                       FontSize="12.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource ThemeAccent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                            <TextBlock x:Name="GlyphText" Grid.Column="1" Text="{Binding Glyph}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="#D6FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="LabelText" Grid.Column="2" Text="{Binding Label}"
                                                       FontSize="13.5" Foreground="{DynamicResource ThemeTextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="9" Foreground="#8CFFFFFF"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border x:Name="Sep" Height="1" Margin="13,7" Background="#1AFFFFFF"
                                        Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Sep" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger Property="UIElement.IsMouseOver" SourceName="Row" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.06">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1" Duration="0:0:0.09">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1" Duration="0:0:0.09">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.09"/>
                                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.92" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="Glow"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="0.92" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
