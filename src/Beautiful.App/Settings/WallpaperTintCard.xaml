<UserControl x:Class="Beautiful.App.Settings.WallpaperTintCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 墙纸取色设置卡（极致美化①）：**自包含** UserControl——样式与资源全部定义在本文件，
         不引用设置窗口宿主的任何 StaticResource（与 ThermalSettingsCard 同一接线约定：宿主只需
         把本控件放进"外观"分区即可，放哪里都不掉样式）。配色沿用宿主同款分区卡片观感
         （半透明白底 + 灰描边 + SystemColors 文字），与其它分区视觉一致。 -->
    <UserControl.Resources>
        <Style x:Key="TintSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="TintHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#0FFFFFFF" BorderBrush="#22808080" BorderThickness="1"
            CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="墙纸取色" Style="{StaticResource TintSectionTitle}"/>

            <CheckBox x:Name="TintEnabledCheck" Content="Dock 玻璃随桌面壁纸取色"
                      Margin="0,0,0,8"
                      Checked="TintEnabled_Changed" Unchecked="TintEnabled_Changed"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="取色强度" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Slider x:Name="TintStrengthSlider" Width="300" Minimum="0" Maximum="100"
                        IsSnapToTickEnabled="True" TickFrequency="5"
                        VerticalAlignment="Center" ValueChanged="TintStrength_Changed"/>
                <TextBlock x:Name="TintStrengthLabel" Text="60%" Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="TintStateText" Style="{StaticResource TintHint}"
                       Text="状态：已关闭"/>

            <TextBlock Style="{StaticResource TintHint}"
                       Text="Dock 底部玻璃会带上当前桌面壁纸的主色调（色相与彩度），玻璃的深浅结构不变。改壁纸后约 1-2 秒生效；幻灯片换页同样跟随。"/>
            <TextBlock Style="{StaticResource TintHint}"
                       Text="幻灯片/纯色桌面、灰阶或近灰壁纸取不出有效主色，此时玻璃保持主题原生色——宁可不取，不给 Dock 上脏色。"/>
        </StackPanel>
    </Border>
</UserControl>
