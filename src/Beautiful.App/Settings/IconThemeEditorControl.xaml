<UserControl x:Class="Beautiful.App.Settings.IconThemeEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="760">
    <!--
        图标主题编辑器（独立自包含 UserControl，设置宿主零依赖）：
        左列 = 当前 Dock 各格（应用名 + 图标缩略 + 覆盖角标），右列 = 选中格的覆盖编辑
        （从 TahoeIcons 图集网格选 / 从本地 PNG 文件选 / 恢复默认），底条 = 主题包导出/导入。
        样式全部就地定义（深色卡片，与 Dock/控制中心同一审美），不引用宿主资源字典；
        通过 IconThemeService.Changed 与 Dock 热刷新同链（服务清缓存 → DockWindow 重建容器）。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="PanelBg" Color="#B4202020" />
        <SolidColorBrush x:Key="RowBg" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="RowBgHover" Color="#3DFFFFFF" />
        <SolidColorBrush x:Key="RowBgSelected" Color="#5C0A84FF" />
        <SolidColorBrush x:Key="Fg" Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="FgDim" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#FF0A84FF" />
        <SolidColorBrush x:Key="BadgeBg" Color="#FF0A84FF" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgDim}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="{StaticResource RowBg}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource RowBgHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="{StaticResource RowBg}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 图集网格的格子按钮（alpha.29 残项清零）：**必须显式给模板**。宿主设置窗口带一个隐式
             Button 样式（Height=28 / Padding=14,0 / 硬编码边框与 CornerRadius=6 的模板），资源查找会
             穿过 UserControl 落到任何未写 Style 的按钮上——图集格子此前正中此枪：56×56 的格子里被
             撑出 28px 水平内边距，44px 缩略图只剩约 26px 的可视槽，右半被裁（真机取证
             docs/evidence/round4/theme-grid-clipped-zoom.png：每格恰好剩约 60%）。本控件头注释承诺
             "样式全部就地定义、不引用宿主资源字典"，这里把承诺补全：零内边距、无边框、内容居中。 -->
        <Style x:Key="GalleryCellButton" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource RowBgHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource RowBgSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource RowBgHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource RowBgSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBg}" CornerRadius="12" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource SectionTitle}" Text="图标主题" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="按应用覆盖 Dock / 启动台图标：左侧选格，右侧换图，改动即时生效（无需重启）。覆盖保存在 config/icon-theme.json。" />
            </StackPanel>

            <!-- 主区：左列格子列表，右列详情 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.15*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="CellList" Grid.Column="0"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CellItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="CellList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Width="30" Height="30" Margin="0,0,9,0"
                                       Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource Fg}" FontSize="12.5"
                                               Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{StaticResource FgDim}" FontSize="10.5"
                                               Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource BadgeBg}" CornerRadius="4"
                                        Padding="5,2" VerticalAlignment="Center"
                                        Visibility="{Binding HasOverride, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="10" Foreground="White" Text="已覆盖" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 详情：选中格的覆盖编辑 -->
                <StackPanel Grid.Column="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="72" Height="72" Margin="0,0,12,0"
                                Background="{StaticResource RowBg}" CornerRadius="14" Padding="8">
                            <Image x:Name="DetailImage" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailTitle" Foreground="{StaticResource Fg}" FontSize="13.5"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailKey" Foreground="{StaticResource FgDim}" FontSize="11"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailOverride" Foreground="{StaticResource FgDim}" FontSize="11"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource EditorButton}" x:Name="PickAssetButton"
                                Content="从图集选择…" Click="PickAssetButton_Click" />
                        <Button Style="{StaticResource EditorButton}" x:Name="PickFileButton"
                                Content="从文件选择…" Margin="8,0,0,0" Click="PickFileButton_Click" />
                        <Button Style="{StaticResource EditorButton}" x:Name="ResetCellButton"
                                Content="恢复默认" Margin="8,0,0,0" Click="ResetCellButton_Click" />
                    </StackPanel>

                    <!-- 图集网格（点「从图集选择…」展开；110 张 TahoeIcons 缩略图，懒加载） -->
                    <Expander x:Name="GalleryExpander" Foreground="{StaticResource Fg}" Margin="0,12,0,0"
                              Header="Tahoe 图集（点击即应用）" Expanded="GalleryExpander_Expanded">
                        <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                            <ItemsControl x:Name="GalleryItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GalleryCellButton}"
                                                ToolTip="{Binding Key}"
                                                Click="GalleryItem_Click">
                                            <Image Source="{Binding Thumb}" Width="44" Height="44"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
            </Grid>

            <!-- 底条：主题包（本地导入导出） -->
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <Border Background="{StaticResource RowBg}" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" FontSize="12.5" Text="主题包（本地导入 / 导出）" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,8"
                                   Text="导出把当前覆盖与图标打成一个 .zip 主题包，分享给别人导入即可复现整套图标；导入前会校验清单（版本 / 路径 / 条目存在性）。" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="{StaticResource FgDim}" FontSize="12"
                                       VerticalAlignment="Center" Text="名称" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" x:Name="PackNameBox" Style="{StaticResource EditorTextBox}"
                                     Text="我的图标主题" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="2" Foreground="{StaticResource FgDim}" FontSize="12"
                                       VerticalAlignment="Center" Text="作者" Margin="0,0,8,0" />
                            <TextBox Grid.Column="3" x:Name="PackAuthorBox" Style="{StaticResource EditorTextBox}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Button Style="{StaticResource EditorButton}" Content="导出主题包…"
                                    Click="ExportPack_Click" />
                            <Button Style="{StaticResource EditorButton}" Content="导入主题包…"
                                    Margin="8,0,0,0" Click="ImportPack_Click" />
                            <Button Style="{StaticResource EditorButton}" Content="全部恢复默认"
                                    Margin="8,0,0,0" Click="ClearAll_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" Margin="2,7,2,0"
                           Text="共 0 条覆盖。" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
