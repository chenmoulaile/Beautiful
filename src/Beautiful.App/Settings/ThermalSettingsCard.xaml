<UserControl x:Class="Beautiful.App.Settings.ThermalSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 温度芯片设置卡（对标 MyDockFinder 温度显示）：**自包含** UserControl——样式与资源全部
         定义在本文件，不引用设置窗口宿主的任何 StaticResource（并行接线：设置集成匠人只需把
         本控件放进"系统"分区即可，样式不依赖宿主字典，放哪里都不掉样式）。配色沿用宿主同款
         分区卡片观感（半透明白底 + 灰描边 + SystemColors 文字），与其它分区视觉一致。 -->
    <UserControl.Resources>
        <Style x:Key="ThermalSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="ThermalHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#0FFFFFFF" BorderBrush="#22808080" BorderThickness="1"
            CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="温度" Style="{StaticResource ThermalSectionTitle}"/>

            <CheckBox x:Name="ThermalEnabledCheck" Content="顶栏显示 CPU 温度芯片"
                      Margin="0,0,0,8"
                      Checked="ThermalEnabled_Changed" Unchecked="ThermalEnabled_Changed"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="刷新间隔" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="RefreshSecondsBox" Width="120" VerticalAlignment="Center"
                          SelectionChanged="RefreshSeconds_Changed">
                    <ComboBoxItem Content="5 秒" Tag="5"/>
                    <ComboBoxItem Content="10 秒" Tag="10"/>
                    <ComboBoxItem Content="15 秒" Tag="15"/>
                    <ComboBoxItem Content="30 秒" Tag="30"/>
                    <ComboBoxItem Content="60 秒" Tag="60"/>
                    <ComboBoxItem Content="120 秒" Tag="120"/>
                </ComboBox>
            </StackPanel>

            <!-- 数据源状态（实时）：四态口径（未获取/已获取未启动/已启动已连接/已连接出数），
                 文案由 Core ThermalSourceStatus 纯函数钉死——读到什么显示什么，拿不到就明说
                 "芯片保持隐藏"，不猜不装，让"为什么没有温度"在这里就有答案。 -->
            <TextBlock x:Name="SourceStatusText" Style="{StaticResource ThermalHint}"
                       Text="数据源状态：检测中…"/>

            <!-- 数据源动作行：获取（官方 GitHub 发布钉死 v0.9.4——最后一个带 WMI 提供方的版本）/
                 启动（UAC 由用户确认）/ 打开目录。三个动作都只放文件或拉起进程，绝不静默装驱动。 -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="FetchSourceButton" Content="获取温度数据源" MinWidth="118"
                        Margin="0,0,8,0" Click="FetchSource_Click"/>
                <Button x:Name="LaunchSourceButton" Content="启动（需要管理员）" MinWidth="118"
                        Margin="0,0,8,0" Click="LaunchSource_Click"/>
                <Button x:Name="OpenToolFolderButton" Content="打开数据源目录" MinWidth="118"
                        Click="OpenToolFolder_Click"/>
            </StackPanel>
            <TextBlock x:Name="ActionHintText" Style="{StaticResource ThermalHint}"
                       Text="" Visibility="Collapsed"/>

            <TextBlock Style="{StaticResource ThermalHint}"
                       Text="温度来自 LibreHardwareMonitor 经 WMI 发布的传感器（官方便携包 v0.9.4 运行即发布，无需配置），已装 OpenHardwareMonitor 的同样可用，兜底读取系统 ACPI 热区。都没有时芯片整体隐藏，不会显示编造的读数。"/>
            <TextBlock Style="{StaticResource ThermalHint}"
                       Text="「获取」从官方 GitHub 发布下载便携包（约 1.9 MB）解压到本地固定目录，不静默安装任何组件；「启动」以管理员权限运行它（弹 UAC 由您确认）——它管理员运行时会装载自带的 WinRing0 内核驱动，这是 LibreHardwareMonitor 自己的行为；拒绝 UAC 也没关系，温度芯片仍可使用其他数据源。"/>
        </StackPanel>
    </Border>
</UserControl>
