<Window x:Class="Beautiful.App.Shell.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="关于本机" Width="520" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource MacWindowBackground}">
    <!-- Phase 4-T2：Big Sur「关于本机」样式。非分层窗口 + WindowChrome + DWM 圆角，
         避免分层窗口关 ClearType（信息卡是文字密集界面）。 -->
    <chrome:WindowChrome.WindowChrome>
        <chrome:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                             GlassFrameThickness="0" CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </chrome:WindowChrome.WindowChrome>

    <Border CornerRadius="10" Background="{DynamicResource MacWindowBackground}"
            BorderBrush="{DynamicResource MacWindowBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="160"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 壁纸缩略：取不到壁纸（幻灯片/纯色）时用渐变底，不伪造图片 -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border x:Name="WallpaperFallback" CornerRadius="9,9,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3A6EA5" Offset="0"/>
                            <GradientStop Color="#1B2A41" Offset="0.6"/>
                            <GradientStop Color="#0E1621" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Image x:Name="WallpaperImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                <Border CornerRadius="9,9,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#99000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,16">
                    <TextBlock Text="Beautiful" FontSize="24" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="#CCFFFFFF" Margin="0,2,0,0"/>
                </StackPanel>

                <Button x:Name="CloseButton" Width="28" Height="28" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,10,10,0" Click="Close_Click"
                        Background="#33FFFFFF" BorderThickness="0" ToolTip="关闭">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                <TextBlock Text="×" FontSize="16" Foreground="#FFFFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="20,16,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Width="72" Height="72" CornerRadius="18" Background="{DynamicResource MacAccent}">
                        <TextBlock Text="B" FontSize="34" FontWeight="Bold" Foreground="#FFFFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Beautiful" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource MacTextPrimary}"/>
                    <TextBlock x:Name="SummaryText" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource MacTextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="112,78,20,0">
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="设备名称" Foreground="{DynamicResource MacTextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="MachineText" Grid.Column="1" Foreground="{DynamicResource MacTextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="型号" Foreground="{DynamicResource MacTextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="ModelText" Grid.Column="1" Foreground="{DynamicResource MacTextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="处理器" Foreground="{DynamicResource MacTextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="CpuText" Grid.Column="1" Foreground="{DynamicResource MacTextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="内存" Foreground="{DynamicResource MacTextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="MemoryText" Grid.Column="1" Foreground="{DynamicResource MacTextPrimary}" FontSize="12"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Windows" Foreground="{DynamicResource MacTextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="OsText" Grid.Column="1" Foreground="{DynamicResource MacTextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="字体" Foreground="{DynamicResource MacTextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="FontText" Grid.Column="1" Foreground="{DynamicResource MacTextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="2" Margin="20,12,20,16">
                <Button Content="更多信息…" Width="96" HorizontalAlignment="Left" Height="28" Click="More_Click"/>
                <Button Content="关闭" Width="72" HorizontalAlignment="Right" Height="28" Click="Close_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
