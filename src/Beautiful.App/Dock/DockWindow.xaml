<services:AcrylicWindow
        x:Class="Beautiful.App.Dock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Beautiful.App.Services"
        xmlns:dock="clr-namespace:Beautiful.App.Dock"
        xmlns:mw="clr-namespace:Beautiful.App.MediaWidget"
        Title="Beautiful Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        Height="98">

    <!-- 窗口 Background={x:Null}：未绘制区域不参与命中测试，两侧点击穿透；
         可见面板 Border 自带背景。主题值统一走 ThemeManager 合并字典的 DynamicResource
         （底色/圆角/图标尺寸/字体/指示样式），切主题换字典即时生效。
         触发器可见性默认值放在元素 Style 中
         （模板触发器可覆盖 Style Setter，但不能覆盖本地值）。 -->
    <services:AcrylicWindow.Resources>
        <!-- 图标烘焙转换器（v3 T6）：条目 → 当前 (源,尺寸,主题,DPI) 下已烘好并冻结的位图。
             必须声明在下面的模板之前（StaticResource 向后不可见）。 -->
        <dock:IconBakedSourceConverter x:Key="IconBaked"/>
        <!-- 通用条目模板（Pinned/Window/RecycleBin）：图标 + 缺失回退字形 + 运行指示 + 悬停高亮。
             Media 条目由 MediaItemTemplate 接管（DockItemTemplateSelector 分派）。 -->
        <DataTemplate x:Key="DefaultItemTemplate">
            <!-- 条目间距在 v2 由 DockSurface 的 Spacing 统一给出（容器 Margin 在生成时被归零），
                 故模板根元素不再自带 Margin。 -->
            <Grid x:Name="ItemRoot" Background="Transparent"
                  ToolTip="{Binding Label}" ToolTipService.Placement="Top"
                  ToolTipService.InitialShowDelay="300">
                <Image x:Name="IconImage" Source="{Binding Converter={StaticResource IconBaked}}"
                       Width="{DynamicResource ThemeIconSize}" Height="{DynamicResource ThemeIconSize}"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <!-- 形状属主（v3 T6 裁定，二者互斥、不会双遮罩）：
                                 · auto/mask 且主题给了形状（macOS 圆角方块 / 鸿蒙 squircle）→ 形状已经
                                   **烧进位图**（连同顶部内高光与投影），ThemeManager 此时不注入本键 → Clip=null；
                                 · plain 方式或 GNOME（主题无遮罩）→ 位图只有像素，形状回到这里的 XAML clip。
                                 macOS 在 v3 T4 之前一直是"无此键 → 原样"，T6 起它由位图负责形状。 -->
                            <Setter Property="Clip" Value="{DynamicResource ThemeIconClip}"/>
                        </Style>
                    </Image.Style>
                </Image>
                <!-- 图标缺失回退字形：回收站 ♻，其余 ▣ -->
                <TextBlock x:Name="FallbackGlyph" FontSize="30" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Text" Value="▣"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="RecycleBin">
                                    <Setter Property="Text" Value="♻"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 运行窗口指示（dot=图标下方圆点 / bar=左侧短条；可见性由主题字典样式决定，
                     Accent 色随主题切换）：none 主题两样式均恒 Collapsed。
                     圆点用**负下 Margin** 探出条目底边，落到行内余量的下半截里（macOS 原生是
                     "图标下方一颗点"，而不是压在图标上）：IconSize=44 + 主题行内余量 10 时图标底边
                     距行底 5 DIP，4 DIP 的点正好嵌在这 5 DIP 里，面板收紧后也不会被裁。
                     Panel.ZIndex 抬到倒影之上（倒影是最后 Add 进 Grid 的，否则点会被镜像盖淡）。 -->
                <Ellipse x:Name="Indicator" Width="4" Height="4" Panel.ZIndex="1"
                         VerticalAlignment="Bottom" Margin="0,0,0,-5"
                         Style="{DynamicResource ThemeIndicatorDot}"/>
                <Rectangle x:Name="IndicatorBar" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Style="{DynamicResource ThemeIndicatorBar}"/>
                <!-- 第三种指示：Win11 任务栏的"图标下方居中短横线"（Windows 主题的观感就靠它，
                     既不是 macOS 的圆点也不是 GNOME 的左侧竖条）。几何写在这里而不在样式里，
                     与上面两兄弟一致；用哪一种是主题字典的事（ThemeIndicatorUnderline 恒
                     Collapsed 的主题就是不用它）。 -->
                <Rectangle x:Name="IndicatorUnderline" Width="16" Height="3" RadiusX="1.5" RadiusY="1.5"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                           Panel.ZIndex="1"
                           Style="{DynamicResource ThemeIndicatorUnderline}"/>
                <Border x:Name="Hover" CornerRadius="12" Background="#22FFFFFF">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="ItemRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- 媒体胶囊槽：承载实况窗胶囊（DataContext = DockWindow.MediaVm）。
             无会话/关闭胶囊时整槽收起（Width=0）：DockSurface 度量到宽度 ≤0 的条目直接跳过排布，
             因此既画出为空、也不留空隙（无需 v1 的 Margin 补偿）。 -->
        <DataTemplate x:Key="MediaItemTemplate">
            <Grid x:Name="ItemRoot" Background="Transparent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width" Value="124"/>
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding MediaVm.HasSession, RelativeSource={RelativeSource AncestorType=dock:DockWindow}}"
                                Value="False">
                                <Setter Property="Width" Value="0"/>
                            </DataTrigger>
                            <!-- 胶囊显示开关（设置项 ShowMediaCapsule，经 MediaVm.CapsuleVisible） -->
                            <DataTrigger
                                Binding="{Binding MediaVm.CapsuleVisible, RelativeSource={RelativeSource AncestorType=dock:DockWindow}}"
                                Value="False">
                                <Setter Property="Width" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <mw:MediaCapsule
                    DataContext="{Binding MediaVm, RelativeSource={RelativeSource AncestorType=dock:DockWindow}}"/>
                <!-- 悬停高亮；不参与命中（放行胶囊内部按钮的点击） -->
                <Border x:Name="Hover" CornerRadius="16" Background="#22FFFFFF" IsHitTestVisible="False"
                        Visibility="Collapsed"/>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="ItemRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- 分隔符条目（macOS 原生 Dock 的「固定应用 | 正在运行 | 废纸篓」结构；GNOME/鸿蒙主题
             DockSeparatorsEnabled=false → 一条也不会生成）。
             三条原生语义都在这里落实：
             ① 粗细/高度/两侧留白全部取主题字典键（由 ThemeManager 按 ThemeDefinition + 当前图标尺寸算出），
                渲染器里没有一行 if (theme == mac)；
             ② 竖线高 = 行高的比例（约 0.65）、垂直居中：macOS 的分隔符明显短于图标行；
             ③ IsHitTestVisible=False：不悬停、不可点击（DockSurface.HitTestItem 也按 Kind 跳过它）。
             它参与行宽（占位），但中心不进放大场 → 缩放恒 1，邻居图标长大时不会被拉伸。 -->
        <DataTemplate x:Key="SeparatorItemTemplate">
            <Grid Width="{DynamicResource ThemeSeparatorBoxWidthDip}" IsHitTestVisible="False"
                  Background="Transparent">
                <Rectangle Width="{DynamicResource ThemeSeparatorWidthDip}"
                           Height="{DynamicResource ThemeSeparatorHeightDip}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           SnapsToDevicePixels="True"
                           Fill="{DynamicResource ThemeDockSeparatorFill}"/>
            </Grid>
        </DataTemplate>
        <!-- 小组件条目（Phase 7-T3）：时钟 + 天气两行字。
             不给图标：图标槽位会让两行文字挤在 44 DIP 里；宽度固定 112，
             使 Dock 的放大场把整块当作一个"图标"处理，邻居推挤仍然自然。 -->
        <DataTemplate x:Key="WidgetItemTemplate">
            <Grid x:Name="ItemRoot" Background="Transparent" Width="112"
                  ToolTip="{Binding Detail}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,1,0,0"
                               HorizontalAlignment="Center" MaxWidth="106"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ThemeTextSecondary}"/>
                </StackPanel>
                <Border x:Name="Hover" CornerRadius="14" Background="#22FFFFFF"
                        IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="ItemRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <dock:DockItemTemplateSelector x:Key="ItemSelector"
                                       DefaultTemplate="{StaticResource DefaultItemTemplate}"
                                       MediaTemplate="{StaticResource MediaItemTemplate}"
                                       SeparatorTemplate="{StaticResource SeparatorItemTemplate}"
                                       WidgetTemplate="{StaticResource WidgetItemTemplate}"/>
        <!-- 条目右键菜单（固定/取消固定）v2 Task 15 起改走 FluentMenu（自绘高级弹层，观感同托盘菜单）：
             代码后置按 DockSurface.HitTestItem 命中的条目在光标处 FluentMenu.Show，不再用原生 ContextMenu。
             历史注记：容器挂 ContextMenuService 的 ContextMenu 在本 AppBar 窗口会把事件路由到
             ItemsControl 层（Source=Surface），容器菜单永远不打开——手动开关语义保留，仅换了菜单实现。 -->
    </services:AcrylicWindow.Resources>
    <!-- v2 Task 6：条目由自绘 DockSurface（Canvas 派生）承载，替代 v1 的 ItemsControl+StackPanel。
         两层叠放在同一个 Grid 单元里：底板 Border 无内容、随 Grid 尺寸拉伸，Grid 尺寸 = Surface 的
         DesiredSize + Surface.Margin → 放大时底板随总宽一起生长，条目几何只写 Left/Top+RenderTransform，
         逐帧不再有 Margin/LayoutTransform 改写。
         窗口保持 AllowsTransparency=True + Background={x:Null}（分层窗口）：面板矩形之外不参与命中测试，
         条带两侧与顶部余量点击穿透（Task 4 约束，勿改成实底）。 -->
    <Grid x:Name="PanelHost" HorizontalAlignment="Center" VerticalAlignment="Bottom"
          TextElement.FontFamily="{DynamicResource ThemeFontFamily}">
        <Border x:Name="DockPanelRoot" Padding="10,6"
                CornerRadius="{DynamicResource ThemePanelCornerRadius}"
                Background="{DynamicResource ThemeDockBackground}"
                BorderBrush="{DynamicResource MacDockBorder}" BorderThickness="1"/>
        <!-- 左右停靠（实验）：竖排面板。复用条目模板，但不参与放大场/倒影/拖放排序——
             那套几何是水平轴写的，强行复用会把 Dock 主路径一起改坏。 -->
        <ItemsControl x:Name="VerticalList" Visibility="Collapsed" Width="112"
                      ItemsSource="{Binding Items}"
                      ItemTemplateSelector="{StaticResource ItemSelector}"
                      Margin="0,8,0,8"
                      PreviewMouseLeftButtonUp="VerticalList_Click"
                      PreviewMouseRightButtonUp="VerticalList_RightUp">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <dock:DockSurface x:Name="Surface" Margin="10,6"
                          ItemsSource="{Binding Items}"
                          TemplateSelector="{StaticResource ItemSelector}"/>
    </Grid>
</services:AcrylicWindow>
