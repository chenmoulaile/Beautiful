<UserControl x:Class="Beautiful.App.Dock.TrayColumnPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Ideal"
             FontFamily="{DynamicResource ThemeFontFamily}"
             Foreground="{DynamicResource ThemeTextPrimary}"
             AutomationProperties.Name="托盘收纳列面板">

    <!-- Dock 托盘收纳列的展开弹层（5.0.0 未闭合项④）。
         【材质与 Dock 面板完全同一套 token】弹层由 FluentPopupHost 承载（分层窗口 + 显示前抓屏模糊），
         三样观感与 Dock 面板同源、不另发明：玻璃底 ThemeDockGlassBackground（Aurora 下即
         DockGlassGradient 公式产物——含 accent/壁纸 tint 的同一份混色）、圆角 ThemePanelCornerRadius、
         顶缘发丝线 AurHairlineBrush（DockWindow 面板同款）。抓屏模糊失败时铺实心玻璃底——
         分层窗口上"没画到"就是看穿到桌面的洞，两条分支都必须把整张卡铺满（Dock 面板本身不抓屏，
         这里是瞬态表面，走 FluentPopupHost 的显示前抓屏，抓到的是 Dock 弹出前的干净桌面）。
         【图标格全部由代码构建】每格"有图/无图/能不能点/为什么不能点"各不相同（同 TopBar 的
         TrayPanel 取舍，xaml 触发器写不出逐格事实）。 -->
    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="32" ShadowDepth="9" Direction="270"
                          Color="#000000" Opacity="0.6"/>

        <!-- 一格托盘图标：40×40 圆角，透明底 + 悬停强调（与顶栏 TrayPanel 同源，不另发明一套）。
             图标下面不放文字——真实托盘本来就没有名字（名字在 ToolTip 里）。 -->
        <Style x:Key="TrayTileStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部动作与分页：透明底 + 悬停强调（与顶栏 TrayPanel 同源） -->
        <Style x:Key="TrayFooterStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="7" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Shell" Margin="20,18,20,24">
        <Border x:Name="Card" Width="330"
                CornerRadius="{DynamicResource ThemePanelCornerRadius}"
                BorderBrush="{DynamicResource MacDockBorder}" BorderThickness="1"
                Background="{DynamicResource ThemeDockGlassBackground}"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <!-- 抓屏模糊可用时的深色遮罩（文字对比度），圆角与卡同键同心：1px 描边正好盖住缝隙 -->
                <Border x:Name="Scrim" CornerRadius="{DynamicResource ThemePanelCornerRadius}"
                        IsHitTestVisible="False" Background="Transparent"/>
                <!-- 顶缘发丝线（Dock 面板同款：1.5 DIP、顶对齐、不参与命中） -->
                <Border Height="1.5" VerticalAlignment="Top"
                        Background="{DynamicResource AurHairlineBrush}" IsHitTestVisible="False"/>

                <StackPanel Margin="13,11,13,9">
                    <!-- 标题行：左"托盘收纳"，右"N 个第三方图标 / 读取中…"（取不到就写读不到，不报假数字） -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="托盘收纳" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HeaderStatus" HorizontalAlignment="Right" MaxWidth="150"
                                   FontSize="11.5" Opacity="0.72" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- 图标区：WrapPanel 平铺，格子由代码加进来 -->
                    <Border x:Name="IconBand" CornerRadius="9" Background="#12FFFFFF" Padding="6,5">
                        <WrapPanel x:Name="IconHost"/>
                    </Border>

                    <!-- 空态：一行诚实文案（两路各自为什么读不到），绝不画一排假图标占位 -->
                    <TextBlock x:Name="EmptyLine" FontSize="11.5" Opacity="0.8" Margin="1,7,1,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- 分页：只有装不下一屏时才出现（一页 24 格，Core TrayLayout 同源） -->
                    <Grid x:Name="PageRow" Margin="0,5,0,0" Visibility="Collapsed">
                        <Button x:Name="PrevButton" Content="上一页" HorizontalAlignment="Left"
                                Style="{StaticResource TrayFooterStyle}" Click="Prev_Click"
                                AutomationProperties.Name="托盘图标 上一页"/>
                        <TextBlock x:Name="PageText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11.5" Opacity="0.72"/>
                        <Button x:Name="NextButton" Content="下一页" HorizontalAlignment="Right"
                                Style="{StaticResource TrayFooterStyle}" Click="Next_Click"
                                AutomationProperties.Name="托盘图标 下一页"/>
                    </Grid>

                    <!-- 状态/结果行：转发点击的结果、失败原因都写在这里，不弹系统气泡 -->
                    <TextBlock x:Name="StatusLine" FontSize="11" Opacity="0.8" Margin="1,7,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- 诊断行：两条路各自读到什么（真机排障第一手判据） -->
                    <TextBlock x:Name="DiagLine" FontSize="10.5" Opacity="0.55" Margin="1,6,1,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Border Height="1" Background="#1AFFFFFF" Margin="1,8,1,0"/>

                    <Grid Margin="0,7,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="刷新" Style="{StaticResource TrayFooterStyle}" Click="Refresh_Click"
                                    AutomationProperties.Name="托盘图标 刷新"/>
                            <Button x:Name="OverflowButton" Content="展开系统隐藏区…" Margin="3,0,0,0"
                                    Style="{StaticResource TrayFooterStyle}" Visibility="Collapsed"
                                    Click="Overflow_Click"
                                    ToolTip="由系统自己展开隐藏图标浮层；它一出现本面板就会关闭（前台只有一个）"
                                    AutomationProperties.Name="托盘图标 展开系统隐藏区"/>
                        </StackPanel>
                        <Button Content="系统通知设置…" HorizontalAlignment="Right"
                                Style="{StaticResource TrayFooterStyle}" Click="OpenSettings_Click"
                                AutomationProperties.Name="托盘图标 打开系统通知设置"/>
                    </Grid>
                    <TextBlock FontSize="10" Opacity="0.55" Margin="1,5,1,0"
                               Text="打开期间每 3 秒自动重读一次；关闭即停，不与顶栏常驻条叠加扫描。"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
