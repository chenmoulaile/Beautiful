<Window x:Class="Beautiful.AnimLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnimLab — Beautiful 动画调参台"
        Width="1180" Height="780" MinWidth="980" MinHeight="640"
        Background="#1C1C1E" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="ToolBtn" TargetType="Button">
      <Setter Property="Background" Value="#3A3A3C"/>
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="BorderBrush" Value="#5A5A5E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#4A4A4E"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2C2C2E"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
      <Setter Property="Background" Value="#0A84FF"/>
      <Setter Property="BorderBrush" Value="#0A84FF"/>
    </Style>
    <Style x:Key="ParamName" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A8A8AE"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style x:Key="ParamBox" TargetType="TextBox">
      <Setter Property="Background" Value="#2C2C2E"/>
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="BorderBrush" Value="#48484C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8E8E93"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,1,0,1"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#ECECEE"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="6,1,0,1"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- 顶部工具条 -->
    <Border DockPanel.Dock="Top" Background="#2A2A2C" Padding="14,9" BorderBrush="#000000" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
          <TextBlock Text="AnimLab — Beautiful 动画调参台" Foreground="#ECECEE" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="ParamsPathText" Foreground="#8E8E93" FontSize="10.5" Margin="0,2,0,0" Text="anim-params.json"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Foreground="#30D158" VerticalAlignment="Center" Margin="0,0,10,0" Text="就绪"/>
          <Button x:Name="BtnReload" Content="重新加载" Style="{StaticResource ToolBtn}" Click="OnReloadClick"/>
          <Button x:Name="BtnSave" Content="保存到 anim-params.json" Style="{StaticResource AccentBtn}" Click="OnSaveClick"/>
          <Button x:Name="BtnDefaults" Content="恢复默认" Style="{StaticResource ToolBtn}" Click="OnDefaultsClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 底部帧时间面板 -->
    <Border DockPanel.Dock="Bottom" Background="#232325" Padding="14,8" BorderBrush="#000000" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="190"/>
        </Grid.ColumnDefinitions>
        <Canvas x:Name="FrameCanvas" VerticalAlignment="Stretch"/>
        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="14,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="AVG" Style="{StaticResource StatLabel}"/><TextBlock x:Name="StatAvg" Style="{StaticResource StatValue}" Text="—"/>
            <TextBlock Text="P95" Style="{StaticResource StatLabel}" Margin="14,1,0,1"/><TextBlock x:Name="StatP95" Style="{StaticResource StatValue}" Text="—"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="MAX" Style="{StaticResource StatLabel}"/><TextBlock x:Name="StatMax" Style="{StaticResource StatValue}" Text="—"/>
            <TextBlock Text="超预算" Style="{StaticResource StatLabel}" Margin="14,1,0,1"/><TextBlock x:Name="StatBad" Style="{StaticResource StatValue}" Text="—"/>
          </StackPanel>
          <TextBlock Text="渲染帧间隔（CompositionTarget · 120 帧 · 基准 16.7ms）" Style="{StaticResource StatLabel}" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主体三列 -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- 左：参数表 -->
      <Border Grid.Column="0" Background="#242426" BorderBrush="#000000" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="anim-params.json" Foreground="#8E8E93" FontSize="11" Margin="14,10,14,6"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ParamsHost" Margin="14,0,14,14"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- 中：演示舞台 -->
      <Grid Grid.Column="1" Margin="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#111113" Margin="12,12,12,6" CornerRadius="8">
          <Canvas x:Name="Stage" ClipToBounds="True"/>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,10" VerticalAlignment="Center">
          <Button x:Name="BtnOpen" Content="打开动画" Style="{StaticResource AccentBtn}" Click="OnOpenClick"/>
          <Button x:Name="BtnClose" Content="关闭动画" Style="{StaticResource ToolBtn}" Click="OnCloseClick"/>
          <Button x:Name="BtnGenie" Content="Genie 条带" Style="{StaticResource ToolBtn}" Click="OnGenieClick"/>
          <Button x:Name="BtnMorph" Content="Morph 缩放" Style="{StaticResource ToolBtn}" Click="OnMorphClick"/>
          <CheckBox x:Name="ChkSlow" Content="慢速 0.3x（观察逐帧几何）" Foreground="#A8A8AE"
                    VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>
      </Grid>

      <!-- 右：缓动曲线 -->
      <Border Grid.Column="2" Background="#242426" BorderBrush="#000000" BorderThickness="1,0,0,0">
        <DockPanel Margin="14,10,14,14">
          <TextBlock DockPanel.Dock="Top" Text="缓动曲线（open=easeOutQuint · close=easeInQuad）"
                     Foreground="#8E8E93" FontSize="11" Margin="0,0,0,6"/>
          <Canvas x:Name="CurvePlot"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
